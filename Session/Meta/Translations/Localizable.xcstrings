    "enjoyingSessionDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنكم تستخدمون Session منذ مدّة، كيف تسير الأمور؟ سنكون ممتنين لسماع رأيكم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session tətbiqini bir müddətdir istifadə edirsiniz, necə gedir? Fikirlərinizi eşitmək bizim üçün çox dəyərli olardı."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has estat utilitzant Session durant una estona, com va? Ens agradaria escoltar els teus pensaments."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Používáte Session <br/>a rádi bychom znali váš názor."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du nutzt Session jetzt schon eine Weile – wie läuft’s? Wir würden uns sehr über dein Feedback freuen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You've been using Session for a little while, how’s it going? We’d really appreciate hearing your thoughts."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has estado usando Session por un tiempo, ¿cómo va todo? Agradeceríamos mucho saber tu opinión."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has estado usando Session por un tiempo, ¿cómo va todo? Agradeceríamos mucho saber tu opinión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدتی است که از Session استفاده می‌کنید، تجربه‌تان چطور بوده است؟ از شنیدن نظرات شما با کمال میل استقبال می‌کنیم."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olet käyttänyt Session vähän aikaa, miten se menee? Olisimme todella arvostaneet ajatuksiasi kuulemista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous utilisez Session depuis un petit moment, comment ça se passe ? Nous aimerions beaucoup connaître votre avis."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप कुछ समय से Session का उपयोग कर रहे हैं, सब कैसा चल रहा है? हम आपके विचार जानकर बहुत आभारी होंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Már egy ideje használod a Session-t, hogy tetszik? Nagyon örülnénk, ha megosztanád velünk a véleményedet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stai usando Session da un po', come ti trovi? Ci farebbe piacere conoscere la tua opinione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionをご利用いただいてしばらく経ちましたね。調子はいかがですか？ご意見をお聞かせいただけると嬉しいです。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်သည် Session ကို အချိန်အနည်းငယ် အသုံးပြုခဲ့ပြီးပါပြီ၊ အဆင်ပြေပါသလား။ သင့်အမြင်များကို ကြားသိလိုပါသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt Session en liten stund, hvordan går det? Vi vil gjerne høre dine tanker."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt Session en liten stund, hvordan går det? Vi vil gjerne høre dine tanker."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je gebruikt Session al een tijdje, hoe gaat het? We horen graag je mening."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har brukt Session en liten stund, hvordan går det? Vi vil gjerne høre dine tanker."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korzystasz z Session już od jakiegoś czasu, jak Ci się podoba? Będziemy bardzo wdzięczni za Twoją opinię."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você está usando o Session há um tempo. Como está sendo a experiência? Adoraríamos saber sua opinião."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já usa o Session há algum tempo, como tem corrido? Gostaríamos muito de ouvir a sua opinião."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosești Session de ceva timp, cum ți se pare? Ne-ar face mare plăcere să aflăm părerea ta."
