        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ಇದು ನಿಮ್ಮ ನಿಜವಾದ ಹೆಸರು, ಒಂದು ಅಲಿಯಾಸ್ ಅಥವಾ ನೀವು ಬೇಕಾದ ಬೇರೆ ಯಾವುದಾ ಆಗಿರಬಹುದು. ಮತ್ತು ನೀವು ಅದನ್ನು ಯಾವಾಗ ಬೇಕಾದರೂ ಬದಲಾಯಿಸಬಹುದು."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실제 이름, 별명 또는 원하는 다른 이름을 입력하세요. 언제든지 변경할 수 있습니다."
          }
        },
        "ku" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وه شاملە تۆ ناوایەتی شەخصیت، پایەی یابێت، یابیش بێ، و توانییتی ھەژندگیرتار کورتەبیت هەرکەی."
