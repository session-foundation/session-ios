        "si-LK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "මෙය ඔබගේ පණිවිඩ සහ සම්බන්ධතා ස්ථිරව delete කෙරේ. ඔබට මෙම උපකරණය පමණක් පිවිසීමට අවශ්‍යද, නැතහොත් ඔබගේ දත්ත ජාලයෙන්ද 삭제 කිරීම."
          }
        },
        "sk" : {
          "stringUnit" : {
            "state" : "translated",
