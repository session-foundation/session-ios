    "hideNoteToSelfDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنتم متيقنون من إخفاء <b>ملاحظة لنفسي</b> من قائمة المحادثات؟"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>Özünə Qeyd</b>i söhbət siyahınızdan gizlətmək istədiyinizə əminsinizmi?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estàs segur que vols amagar <b>Nota a Si Mateix</b> de la teva llista de converses?"
