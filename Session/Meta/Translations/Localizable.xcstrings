          }
        },
        "te" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "మీ కొత్త సెట్టింగ్స్‌ని ఉపయోగించాలంటే, మీరు Sessionను రీస్టార్ట్ చేయాలి."
          }
        },
        "th" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณต้องรีสตาร์ท Session เพื่อใช้งานการตั้งค่าใหม่ของคุณ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yeni ayarların uygulanması için Session'i yeniden başlatmanız gerekiyor."
