    "promoteAdminsWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيتمكن المسؤولون من رؤية سجل الرسائل لآخر 14 يوماً ولا يمكن خفض رتبتهم أو إزالتهم من المجموعة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adminlər, son 14 günə aid mesaj tarixçəsini görə biləcək. Onların vəzifəsini azaltmaq və ya onları qrupdan xaric etmək mümkün deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Správci budou moci vidět historii zpráv za posledních 14 dní a nemohou být ponížení ani odebráni ze skupiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratoren können den Nachrichtenverlauf der letzten 14 Tage sehen und nicht herabgestuft oder aus der Gruppe entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Admins will be able to see the last 14 days of message history and cannot be demoted or removed from the group."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los admins podrán ver el historial de mensajes de los últimos 14 días y no podrán ser degradados ni eliminados del grupo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los administradores podrán ver el historial de mensajes de los últimos 14 días y no podrán ser degradados ni eliminados del grupo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مدیران خواهند توانست تاریخچهٔ پیام‌های ۱۴ روز اخیر را ببینند و نمی‌توان آن‌ها را عزل یا از گروه حذف کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ylläpitäjät voivat nähdä viimeiset 14 päivää viestihistoriaa eikä heitä voida alentaa tai poistaa ryhmästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les administrateurs pourront voir les 14 derniers jours d'historique des messages et ne pourront pas être rétrogradés ou supprimés du groupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एडमिन पिछले 14 दिनों के संदेश इतिहास को देख सकेंगे और उन्हें डिमोट या समूह से हटाया नहीं जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az adminisztrátorok hozzáférnek az elmúlt 14 nap üzenettörténetéhez, és nem lehet őket lefokozni vagy eltávolítani a csoportból."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli amministratori potranno visualizzare gli ultimi 14 giorni di cronologia dei messaggi e non potranno essere retrocessi né rimossi dal gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理者は過去14日間のメッセージ履歴を閲覧でき、降格やグループから削除することはできません。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အက်ဒမင်များသည် နောက်ဆုံး 14 ရက်အတွင်းမှ မက်ဆေ့ချ်မှတ်တမ်းကို မြင်နိုင်မည်ဖြစ်ပြီး အက်ဒမင်များကို အဖွဲ့မှ အဆင့်လျှော့ချခြင်း သို့မဟုတ် ဖယ်ရှားခြင်း မပြုနိုင်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorer vil kunne se de siste 14 dagene med meldingshistorikk og kan ikke degraderes eller fjernes fra gruppen."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorer vil kunne se de siste 14 dagene med meldingshistorikk og kan ikke degraderes eller fjernes fra gruppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beheerders kunnen de laatste 14 dagen van de berichtgeschiedenis bekijken en kunnen niet worden gedegradeerd of uit de groep worden verwijderd."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorer vil kunne se de siste 14 dagene med meldingshistorikk og kan ikke degraderes eller fjernes fra gruppen."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorzy będą mogli zobaczyć historię wiadomości z ostatnich 14 dni i nie będzie można ich zdegradować ani usunąć z grupy."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administradores poderão ver o histórico de mensagens dos últimos 14 dias e não poderão ser rebaixados ou removidos do grupo."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os admins poderão ver o histórico de mensagens dos últimos 14 dias e não poderão ser despromovidos ou removidos do grupo."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratorii vor putea vedea istoricul mesajelor din ultimele 14 zile și nu pot fi retrogradați sau eliminați din grup."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Администраторы смогут просматривать историю сообщений за последние 14 дней и не могут быть понижены или удалены из группы."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Administratörer kommer att kunna se de senaste 14 dagarnas meddelandehistorik och kan inte nedgraderas eller tas bort från gruppen."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yöneticiler son 14 güne ait mesaj geçmişini görebilir ve gruptan çıkarılamaz veya görevden alınamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Адміністратори зможуть бачити історію повідомлень за останні 14 днів і не можуть бути понижені або видалені з групи."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理员将能够查看最近14天的消息记录，且无法被降级或从群组中移除。"
          }
        }
