          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja płatność została pomyślnie przetworzona, ale wystąpił błąd podczas {action_type} statusu Pro.<br/><br/>Sprawdź połączenie z siecią i spróbuj ponownie."
          }
