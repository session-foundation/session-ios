        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visszaállítási jelszó nélkül nem tudod betölteni a felhasználódat új eszközökön. <br/><br/>Erősen ajánljuk a visszaálltási jelszó biztonságos helyen történő mentését."
