    "communityModLegacyHostedServer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتم استضافة هذا المجتمع على خادم يُشغّل إصدارًا قديمًا من برنامج Session وسيصبح للقراءة فقط ما لم تتم ترقيته {icon}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Community is hosted on a server running legacy Session software and will become read-only unless upgraded {icon}"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta comunidad está alojada en un servidor corriendo el software legacy Session y será de solo lectura a no ser que se actualice {icon}"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این انجمن روی سروری میزبانی می‌شود که نرم‌افزار قدیمی Session را اجرا می‌کند و در صورت ارتقا نیافتن فقط‌‑خواندنی خواهد شد {icon}"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤကွန်မြူနတီကို legacy Session ဆော့ဖ်ဝဲကို လည်ပတ်နေသော ဆာဗာတစ်ခုပေါ်တွင် host လုပ်ထားပြီး အဆင့်မြှင့်တင်ခြင်း မပြုပါက ဖတ်ရန်သာ ဖြစ်သွားမည် {icon}"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это сообщество размещено на сервере с устаревшей версией Session и станет доступным только для чтения, если не обновить {icon}"
          }
        }
      }
    },
    "communityModModeratorCannotManage" : {
