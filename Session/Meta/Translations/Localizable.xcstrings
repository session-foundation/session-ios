    "groupNameContainedUrlJoinCommunity" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مصطلح البحث الذي أدخلتم يحتوي على رابط مجتمع. <br/><br/>هل ترغبون في الانضمام لهذا المجتمع عوضاً عن إنشاء مجموعة جديدة؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The group name you entered contained a Community URL.<br/><br/>Would you like to join this Community instead of creating a new group?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre del grupo que ingresaste contiene la URL de la comunidad.<br/><br/>¿Te gustaría ingresar esta comunidad en lugar de crear un nuevo grupo?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام گروهی که وارد کردید شامل نشانی یک انجمن بود.<br/><br/>آیا می‌خواهید به‌جای ایجاد یک گروه جدید، به این انجمن بپیوندید؟"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megadott csoportnév egy közösség címét tartalmazta.<br/><br/>Csatlakozni akar a közösséghez, egy új csoport létrehozása helyett?"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်ရိုက်ထည့်ခဲ့သော အဖွဲ့အမည်တွင် ကွန်မြူနတီ URL တစ်ခု ပါဝင်နေပါသည်။<br/><br/>အဖွဲ့အသစ်တစ်ခု ဖန်တီးမည့်အစား ဤ ကွန်မြူနတီကို ဝင်ရောက်လိုပါသလား။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В названии группы есть адрес сообщества.<br/><br/>Хотите присоединиться к нему вместо создания новой группы?"
          }
        }
      }
    },
    "groupNameContainedUrlOpenCommunity" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسم المجموعة التي أدخلتم يحتوي على رابط لمجتمع.<br/><br/>أنتم منضمون فعلًا إلى مجتمع <b>{community_name}</b>، هل ترغبون في فتح محادثة هذا المجتمع بدلاً من إنشاء مجموعة جديدة؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The group name you entered contained a Community URL.<br/><br/>You have already joined the <b>{community_name}</b> Community, would you like to open this Community conversation instead of creating a new group?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El nombre del grupo al que ingresaste contiene una URL de la comunidad.<br/><br/>Ya has ingresado a la comunidad <b>{community_name}</b>, ¿te gustaría abrir esta conversación de la comunidad en vez de crear un nuevo grupo?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نام گروهی که وارد کردید شامل نشانی یک انجمن بود.<br/><br/>شما قبلاً به انجمن <b>{community_name}</b> پیوسته‌اید. آیا می‌خواهید به‌جای ایجاد یک گروه جدید، مکالمهٔ این انجمن را باز کنید؟"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A megadott csoportnév egy közösség címét tartalmazta.<br/><br/>Már tagja a <b>{community_name}</b> közösségnek. Meg kívánja nyitni ezt a közösségi társalgást, egy új csoport megnyitása helyett?"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်ထည့်သွင်းခဲ့သော အဖွဲ့အမည်တွင် ကွန်မြူနတီ URL တစ်ခု ပါဝင်နေသည်။<br/><br/>သင်သည် <b>{community_name}</b> ကွန်မြူနတီသို့ ဝင်ရောက်ပြီးသားဖြစ်သည်။ အဖွဲ့အသစ်တစ်ခု ဖန်တီးမည့်အစား ဤ ကွန်မြူနတီ စကားဝိုင်းကို ဖွင့်လိုပါသလား။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В названии группы есть адрес сообщества.<br/><br/>Вы уже участвуете в <b>{community_name}</b>. Хотите поговорить там вместо создания новой группы?"
          }
        }
      }
    },
