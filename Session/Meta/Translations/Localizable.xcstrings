    "proAccessLoadingDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ تحميل معلومات الوصول إلى Pro الخاصة بكم. لا يمكن التحديث حتى تكتمل هذه العملية."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informace o vašem přístupu k Pro se stále načítají. Dokud nebude tento proces dokončen, nemůžete provézt aktualizaci."
          }
        },
        "de" : {
          "stringUnit" : {
