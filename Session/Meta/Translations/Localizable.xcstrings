          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La información de tu acceso a Pro aún se está cargando. No puedes actualizar hasta que se complete este proceso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلاعات دسترسی Pro شما هنوز در حال بارگیری است. تا تکمیل شدن این فرایند، نمی‌توانید به‌روزرسانی انجام دهید."
