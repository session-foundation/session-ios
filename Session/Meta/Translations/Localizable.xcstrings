    "setPasswordModalDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعيين كلمة مرور لـ Session. سيتم تشفير البيانات المخزنة محليًا باستخدام هذه الكلمة. سيُطلب منكم إدخال هذه الكلمة في كل مرة يبدأ فيها Session."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session üçün bir parol təyin edin. Daxili olaraq saxlanılmış verilər, bu parolla şifrələnəcək. Session tətbiqini hər başlatdıqda, sizdən bu parolu daxil etməyiniz istənəcək."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavte heslo pro Session. Lokálně uložená data budou šifrována tímto heslem. Při každém spuštění Session budete vyzváni k zadání tohoto hesla."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setze ein Passwort für Session. Lokal gespeicherte Dateien werden mit diesem Passwort verschlüsselt. Du wirst jedes Mal nach diesem Passwort gefragt, wenn du Session startest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set a password for Session. Locally stored data will be encrypted with this password. You will be asked to enter this password each time Session starts."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece una contraseña para Session. Los datos almacenados localmente se cifrarán con esta contraseña. Se te pedirá que ingreses esta contraseña cada vez que se inicie Session."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establece una contraseña para Session. Los datos almacenados localmente se cifrarán con esta contraseña. Se te pedirá que ingreses esta contraseña cada vez que se inicie Session."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "برای Session یک گذرواژه تنظیم کنید. داده‌های ذخیره‌شدهٔ محلی با این گذرواژه رمزگذاری خواهند شد. هر بار که Session آغازبه‌کار کند، از شما خواسته می‌شود این گذرواژه را وارد کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aseta salasana sovellukselle Session. Paikallisesti tallennetut tiedot salataan tällä salasanalla. Sinua pyydetään syöttämään tämä salasana aina, kun Session käynnistyy."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez un mot de passe pour Session. Les données stockées localement seront chiffrées avec ce mot de passe. Il vous sera demandé de saisir ce mot de passe chaque fois que Session sera lancé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session के लिए एक पासवर्ड सेट करें। इस पासवर्ड से स्थानीय रूप से संग्रहीत डेटा एन्क्रिप्ट किया जाएगा। हर बार Session शुरू करने पर आपसे यह पासवर्ड माँगा जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Állítson be egy jelszót a(z) Session alkalmazáshoz. A helyileg tárolt adatok ezzel a jelszóval lesznek titkosítva. Minden alkalommal, amikor elindítja a(z) Session alkalmazást, meg kell adnia ezt a jelszót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Imposta una password per Session. I dati memorizzati localmente verranno crittografati con questa password. Ti verrà chiesto di inserirla ogni volta che Session viene avviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session のパスワードを設定します。ローカルに保存されたデータはこのパスワードで暗号化されます。Session の起動時に毎回このパスワードの入力が求められます。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session အတွက် စကားဝှက်တစ်ခု သတ်မှတ်ပါ။ စက်တွင် သိမ်းဆည်းထားသော ဒေတာများကို ဤစကားဝှက်ဖြင့် ကုဒ်ဝှက်ထားပါမည်။ Session ကို စတင်တိုင်း ဤစကားဝှက်ကို ထည့်သွင်းရန် သင့်အား တောင်းဆိုပါမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi et passord for Session. Lokalt lagrede data vil bli kryptert med dette passordet. Du vil bli bedt om å skrive inn dette passordet hver gang Session startes."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi et passord for Session. Lokalt lagrede data vil bli kryptert med dette passordet. Du vil bli bedt om å skrive inn dette passordet hver gang Session startes."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stel een wachtwoord in voor Session. Lokaal opgeslagen gegevens worden versleuteld met dit wachtwoord. Je wordt gevraagd dit wachtwoord in te voeren telkens wanneer Session wordt gestart."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Angi et passord for Session. Lokalt lagrede data vil bli kryptert med dette passordet. Du vil bli bedt om å skrive inn dette passordet hver gang Session startes."
