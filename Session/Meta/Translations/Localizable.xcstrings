    "cameraAccessReminderMessage" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثناء مكالمتكم الأخيرة، حاولتم استخدام الفيديو لكن لم تتمكنوا من ذلك لأنه تم رفض الوصول إلى الكاميرا من قبل. للسماح بالوصول، افتحوا الإعدادات وفعّلوا صلاحية الكاميرا."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son zəng zamanı, görüntünü istifadə etməyə çalışdınız, ancaq kamera erişiminə daha əvvəl rədd cavabı verildiyi üçün edə bilmədiniz. Kamera erişiminə icazə vermək üçün ayarları açıb Kamera icazəsini işə salın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Během posledního hovoru jste se pokusili použít video, ale nebylo to možné, protože přístup k fotoaparátu byl dříve zamítnut. Chcete-li povolit přístup k fotoaparátu, otevřete nastavení a povolte oprávnění k fotoaparátu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während Ihres letzten Anrufs haben Sie versucht, Video zu verwenden, konnten dies jedoch nicht, da der Kamerazugriff zuvor verweigert wurde. Um den Kamerazugriff zu erlauben, öffnen Sie die Einstellungen und aktivieren Sie die Kameraberechtigung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During your last call, you tried to use video but couldn’t because camera access was previously denied. To allow camera access, open settings and turn on the Camera permission."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante tu última llamada, intentaste usar el video pero no fue posible porque se denegó previamente el acceso a la cámara. Para permitir el acceso a la cámara, abre la configuración y activa el permiso de Cámara."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante tu última llamada, intentaste usar el video pero no fue posible porque se denegó previamente el acceso a la cámara. Para permitir el acceso a la cámara, abre la configuración y activa el permiso de Cámara."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در آخرین تماس خود، سعی کردید از ویدئو استفاده کنید اما نتوانستید، چون که دسترسی به دوربین قبلاً رد شده بود. برای دادن اجازهٔ دسترسی به دوربین، تنظیمات را باز و اجازه دوربین را روشن کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viimeisimmän puhelusi aikana yritit käyttää videota, mutta et voinut, koska kameran käyttöoikeus oli aiemmin evätty. Ota kameran käyttöoikeus käyttöön avaamalla asetukset ja sallimalla Kamera-oikeus."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lors de votre dernier appel, vous avez tenté d’utiliser la vidéo, mais cela n’a pas été possible car l’accès à la caméra avait été précédemment refusé. Pour autoriser l’accès à la caméra, ouvrez les paramètres et activez l’autorisation caméra."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी पिछली कॉल के दौरान, आपने वीडियो का उपयोग करने की कोशिश की थी लेकिन कैमरा एक्सेस पहले से अस्वीकृत होने के कारण ऐसा नहीं कर सके। कैमरा एक्सेस की अनुमति देने के लिए, सेटिंग्स खोलें और कैमरा अनुमति चालू करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előző hívás során megpróbáltad használni a videót, de nem sikerült, mert a kamera-hozzáférés korábban megtagadásra került. A hozzáférés engedélyezéséhez nyisd meg a beállításokat, és kapcsold be a Kamera engedélyt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la tua ultima chiamata hai provato a usare il video ma non è stato possibile perché l'accesso alla fotocamera era stato precedentemente negato. Per consentirlo, apri le impostazioni e attiva l'autorizzazione Fotocamera."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最後の通話中にビデオを使用しようとしましたが、以前にカメラへのアクセスを拒否されたため使用できませんでした。カメラへのアクセスを許可するには、設定を開いてカメラの権限をオンにしてください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်၏ နောက်ဆုံးခေါ်ဆိုမှုအတွင်း သင်သည် ဗီဒီယိုကို အသုံးပြုရန် ကြိုးစားခဲ့သော်လည်း ယခင်က ကင်မရာအသုံးပြုခွင့်ကို ငြင်းပယ်ထားသောကြောင့် အသုံးမပြုနိုင်ခဲ့ပါ။ ကင်မရာ အသုံးပြုခွင့်ကို ခွင့်ပြုရန် ဆက်တင်များကို ဖွင့်ပြီး ကင်မရာ ခွင့်ပြုချက်ကို ဖွင့်ပါ။"
          }
        },
