          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session hat deinen Pro-Zugang erkannt und wiederhergestellt. Dein Pro-Status wurde zurückgesetzt!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session detected and recovered Pro access for your account. Your Pro status has been restored!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session detectó y recuperó el acceso Pro para tu cuenta. ¡Tu estado Pro ha sido restaurado!"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session detectó y recuperó el acceso Pro para tu cuenta. ¡Tu estado Pro ha sido restaurado!"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session دسترسی Pro را برای حساب کاربری شما شناسایی و بازیابی کرد. وضعیت Pro شما بازگردانده شد!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
