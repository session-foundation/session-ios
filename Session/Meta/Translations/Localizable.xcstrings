    "helpReportABugExportLogsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer jou logboeke uit, laai dan die lêer deur Session se Hulptoonbank."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تصدير السجلات الخاصة بكم، ثم رفع الملف عبر مكتب المساعدة الخاص بـSession."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jurnalı xaricə köçürün və Session Kömək Masası üzərindən yükləyin."
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اپنی lockاتنیں ایکسپورٹ بکنے کے بعد، فائل Session کے مدد ڈیسک میں اپلوڈ بکنا۔"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Экспартуйце свае часопісы, затым загрузіце файл у службу падтрымкі Session."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Експортирайте своите дневници, след което качете файла чрез Help Desk на Session."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনার লগ গুলি রপ্তানি করুন, তারপর ফাইলটি Session's এর সাহায্যের ডেস্ক এর মাধ্যমে আপলোড করুন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exporta els vostres registres i, a continuació, carregueu el fitxer mitjançant el Servei d'Ajut de Session."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportujte své logy, pak nahrajte soubor přes Session's Help Desk."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allforiwch eich cofnodion, yna llwythwch y ffeil trwy Desg Gymorth Session."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eksportér dine logs, og upload derefter filen via Session's Help Desk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exportiere deine Protokolle und lade die Datei über den Session Helpdesk hoch."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
