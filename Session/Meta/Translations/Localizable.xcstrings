          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nové funkce Pro již brzy. Podívejte se, co chystáme, na <b>plánu vývoje Pro</b> {icon}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neue Funktionen kommen bald zu Pro. Erfahre, was als Nächstes geplant ist auf der <b>Pro Roadmap</b> {icon}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "New features coming soon to Pro. Discover what's next on the <b>Pro Roadmap</b> {icon}"
