    "conversationsMessageTrimmingTrimCommunitiesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف الرسائل الأقدم من 6 أشهر تلقائيًا في المجتمعات ذات أكثر من 2000 رسالة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,000-dən çox mesajı olan icmalarda 6 aydan köhnə mesajları avtomatik sil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Z komunit automaticky mazat zprávy starší než 6 měsíců, pokud jich je více než 2000."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nachrichten älter als 6 Monate in Communities mit mehr als 2000 Nachrichten automatisch löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auto-delete messages older than 6 months in communities with 2000+ messages."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar automáticamente los mensajes con más de 6 meses de antigüedad en comunidades con más de 2000 mensajes."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eliminar automáticamente los mensajes con más de 6 meses de antigüedad en comunidades con más de 2000 mensajes."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف خودکار پیام‌های قدیمی‌تر از ۶ ماه در انجمن‌های دارای بیش از ۲۰۰۰ پیام."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poista automaattisesti viestit, jotka ovat vanhempia kuin 6 kuukautta, yhteisöissä joissa on yli 2000 viestiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimer automatiquement les messages de plus de 6 mois dans les communautés ayant plus de 2000 messages."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐसी समुदायों में जहाँ 2000 से अधिक संदेश हों, वहाँ 6 महीने से पुराने संदेशों को स्वचालित रूप से हटा दिया जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A 2000+ üzenetet tartalmazó közösségekben automatikusan törli a 6 hónapnál régebbi üzeneteket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elimina automaticamente i messaggi più vecchi di 6 mesi nelle community con oltre 2000 messaggi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2,000件以上のメッセージがあるコミュニティでは、6か月以上前のメッセージを自動的に削除します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2000개 이상의 메시지가 있는 커뮤니티에서 6개월 이상 지난 메시지를 자동 삭제."
          }
        },
        "my" : {
          "stringUnit" : {
