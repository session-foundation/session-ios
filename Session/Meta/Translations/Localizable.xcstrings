    "paymentProError" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت معالجة دفعتكم بنجاح، ولكن حدث خطأ أثناء {action_type} حالة Pro الخاصة بكم.<br/><br/>يرجى التحقق من اتصال الشبكة والمحاولة مرة أخرى."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše platba byla úspěšně zpracována, ale došlo k chybě {action_type} vašeho stavu Pro.<br/><br/>Zkontrolujte prosím vaše síťové připojení a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Zahlung wurde erfolgreich verarbeitet, aber es gab einen Fehler beim {action_type} deines Pro-Status.<br/><br/>Bitte überprüfe deine Netzwerkverbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your payment has been processed successfully, but there was an error {action_type} your Pro status.<br/><br/>Please check your network connection and retry."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pago se ha procesado correctamente, pero hubo un error al {action_type} tu estado Pro.<br/><br/>Verifica tu conexión de red e inténtalo de nuevo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu pago se ha procesado correctamente, pero hubo un error al {action_type} tu estado Pro.<br/><br/>Verifica tu conexión de red e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پرداخت شما با موفقیت پردازش شد، اما در {action_type} وضعیت Pro شما خطایی رخ داد.<br/><br/>لطفاً اتصال شبکهٔ خود را بررسی کرده و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maksusi on käsitelty onnistuneesti, mutta tapahtui virhe {action_type} Pro-tilastatusi kanssa.<br/><br/>Tarkista verkkoyhteytesi ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre paiement a été traité avec succès, mais une erreur est survenue lors de la {action_type} de votre statut Pro.<br/><br/>Veuillez vérifier votre connexion réseau et réessayer."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपका भुगतान सफलतापूर्वक संसाधित हो गया है, लेकिन आपके Pro स्टेटस को {action_type} करते समय एक त्रुटि हुई।<br/><br/>कृपया अपने नेटवर्क कनेक्शन की जाँच करें और पुनः प्रयास करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fizetésed sikeresen megtörtént, de hiba történt a(z) Pro státuszod {action_type} közben.<br/><br/>Kérjük, ellenőrizd a hálózati kapcsolatodat, és próbáld újra."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo pagamento è stato elaborato correttamente, ma si è verificato un errore durante {action_type} lo stato Pro.<br/><br/>Controlla la connessione di rete e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "お支払いは正常に処理されましたが、Proステータスの{action_type}中にエラーが発生しました。<br/><br/>ネットワーク接続を確認して、再試行してください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်ငွေပေးချေမှုကို အောင်မြင်စွာ ဆောင်ရွက်ပြီး ဖြစ်သော်လည်း သင့် Pro အခြေအနေကို {action_type} လုပ်ရာတွင် ချွတ်ယွင်းချက်တစ်ခု ဖြစ်ပွားခဲ့သည်။<br/><br/>ကျေးဇူးပြု၍ သင့်ကွန်ရက် ချိတ်ဆက်မှုကို စစ်ဆေးပြီး ထပ်မံ ကြိုးစားပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Betalingen din ble behandlet, men det oppstod en feil ved {action_type} av Pro-statusen din.<br/><br/>Sjekk nettverkstilkoblingen og prøv igjen."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
