    "proStatusNetworkErrorContinue" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر الاتصال بالشبكة للتحقق من حالة Pro الخاصة بكم. لا يمكن المتابعة حتى تتم استعادة الاتصال.<br/><br/>يرجى التحقق من اتصالكم بالشبكة ثم المحاولة مجددًا."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nelze se připojit k síti, aby bylo možné zkontrolovat váš stav Pro. Dokud nebude obnoveno připojení, nelze pokračovat.<br/><br/>Zkontrolujte připojení k síti a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbindung zum Netzwerk zur Überprüfung deines Pro-Status nicht möglich. Du kannst erst fortfahren, wenn die Verbindung wiederhergestellt ist.<br/><br/>Bitte überprüfe deine Netzwerkverbindung und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unable to connect to the network to check your Pro status. You cannot continue until connectivity is restored.<br/><br/>Please check your network connection and retry."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar a la red para verificar tu estado Pro. No puedes continuar hasta que se restaure la conectividad.<br/><br/>Verifica tu conexión de red e inténtalo de nuevo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo conectar a la red para verificar tu estado Pro. No puedes continuar hasta que se restaure la conectividad.<br/><br/>Verifica tu conexión de red e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "امکان اتصال به شبکه برای بررسی وضعیت Pro شما وجود ندارد. تا زمانی که اتصال برقرار نشود، نمی‌توانید ادامه دهید.<br/><br/>لطفاً اتصال شبکهٔ خود را بررسی کرده و دوباره تلاش کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verkkoyhteyttä ei voida muodostaa Pro-tilan tarkistamiseksi. Et voi jatkaa ennen kuin yhteys on palautettu.<br/><br/>Tarkista verkkoyhteys ja yritä uudelleen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible de se connecter au réseau pour vérifier votre statut Pro. Vous ne pouvez pas continuer tant que la connexion n'est pas rétablie.<br/><br/> Veuillez vérifier votre connexion réseau et réessayer."
