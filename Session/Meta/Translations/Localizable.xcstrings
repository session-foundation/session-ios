    "nonProLongerMessagesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرسال رسائل تصل إلى 10,000 حرف في جميع المحادثات."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bütün danışıqlarda 10,000 xarakterə qədər mesaj göndərin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ve všech konverzacích můžete odesílat zprávy o délce až 10000 znaků."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versenden Sie Nachrichten mit bis zu 10.000 Zeichen in allen Unterhaltungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send messages up to 10,000 characters in all conversations."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía mensajes de hasta 10 000 caracteres en todas las conversaciones."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía mensajes de hasta 10,000 caracteres en todas las conversaciones."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پیام‌هایی با سقف ۱۰٬۰۰۰ نویسه در همهٔ مکالمه‌ها ارسال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lähetä jopa 10 000 merkin pituisia viestejä kaikissa keskusteluissa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez envoyer des messages d'une taille maximale de 10 000 caractères dans toutes les conversations."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "सभी वार्तालापों में 10,000 वर्णों तक के संदेश भेजें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb 10 000 karakteres üzeneteket küldhetsz minden beszélgetésben."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invia messaggi fino a 10.000 caratteri in tutte le conversazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての会話で最大10,000文字のメッセージを送信できます。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စကားဝိုင်းအားလုံးတွင် အက္ခရာ 10,000 အထိရှိသော မက်ဆေ့ချ်များကို ပို့နိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send meldinger på opptil 10 000 tegn i alle samtaler."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send meldinger på opptil 10 000 tegn i alle samtaler."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzend berichten tot 10.000 tekens in alle gesprekken."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Send meldinger på opptil 10 000 tegn i alle samtaler."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wysyłaj wiadomości do 10 000 znaków we wszystkich konwersacjach."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
