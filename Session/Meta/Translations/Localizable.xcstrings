    "notificationWarningDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب تشغيل إشعارات الوضع السريع لتلقي إشعارات مكالمات عندما يكون Session مغلقًا. يستخدم هذا الجهاز حاليًا إشعارات الوضع البطيء.<br/><br/>هل ترغبون في تغيير إعدادات الإشعارات؟"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fast Mode notifications must be turned on to receive reliable call notifications when Session is closed. This device is currently using Slow Mode notifications.<br/><br/>Would you like to change your notification settings?"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notificaciones del modo rápido han sido habilitadas para recibir notificaciones de llamadas confiables cuando se cierra Session. Este dispositivo está utilizando actualmente el Modo lento.<br/><br/>¿Te gustaría cambiar la configuración de tus notificaciones?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اعلان‌های حالت سریع، برای دریافت اعلان‌های قابل‌اعتماد برای تماس وقتی Session بسته است، باید روشن باشند. این دستگاه در حال حاضر از اعلان‌های حالت کند استفاده می‌کند.<br/><br/>آیا می‌خواهید تنظیمات اعلان خود را تغییر دهید؟"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ကို ပိတ်ထားသောအခါ ယုံကြည်စိတ်ချရသော ခေါ်ဆိုမှု အသိပေးချက်များကို လက်ခံရရှိရန် Fast Mode အသိပေးချက်များကို ဖွင့်ထားရပါမည်။ လက်ရှိတွင် ဤစက်သည် Slow Mode အသိပေးချက်များကို အသုံးပြုနေပါသည်။<br/><br/>သင်၏ အသိပေးချက် ဆက်တင်များကို ပြောင်းလိုပါသလား။"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powiadomienia w trybie szybkim muszą być włączone, aby otrzymywać niezawodne powiadomienia o połączeniach po zamknięciu aplikacji Session. To urządzenie korzysta obecnie z powiadomień w trybie zwolnionym.<br/><br/>Czy chcesz zmienić ustawienia powiadomień?"
          }
        },
