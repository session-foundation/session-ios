    "appearanceLanguageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kies jou taalinstelling vir Session. Session sal herbegin wanneer jy jou taalinstelling verander."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختيار إعدادات اللغة الخاصة بكم لتطبيق Session. سيعيد Session التشغيل عند تغيير إعدادات اللغة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session üçün dil ayarlarınızı seçin. Dil ayarlarını dəyişdirdikdə Session yenidən başladılacaq."
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session کے لے آپنی زبان کے ترتیب کو منتخب کریں۔ جب آپ اپنی زبان کی ترتیب بدلیں گے، Session دوبارہ شروع ہوگا۔"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Абярыце налады мовы для Session. Session перазапусціцца пасля змены налад мовы."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Изберете езиковите настройки за Session. Session ще се рестартира при промяна на езиковите настройки."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session জন্য আপনার ভাষা সেটিং নির্বাচন করুন। আপনার ভাষা সেটিং পরিবর্তন করলে Session পুনরায় শুরু হবে।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trieu la configuració de l'idioma per a Session. Session es reiniciarà quan canvieu la configuració de l'idioma."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte jazykové nastavení pro Session. Session se restartuje, když změníte jazykové nastavení."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dewiswch eich gosodiad iaith ar gyfer Session. Bydd Session yn ailgychwyn pan fyddwch chi'n newid eich gosodiad iaith."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vælg din sproglige indstilling for Session. Session vil genstarte, når du ændrer dine sprogindstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle deine Spracheinstellung für Session. Session wird neu gestartet, wenn du deine Spracheinstellung änderst."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Επιλέξτε τις γλωσσικές ρυθμίσεις για το Session. Το Session θα επανεκκινήσει όταν αλλάξετε τις γλωσσικές σας ρυθμίσεις."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose your language setting for Session. Session will restart when you change your language setting."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elektu vian lingv-agordon por Session. Session rekomenciĝos kiam vi ŝanĝos vian lingv-agordon."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige la configuración de idioma para Session. Session se reiniciará cuando cambies tu configuración de idioma."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige tu configuración de idioma para Session. Session se reiniciará cuando tu configuración de idioma cambie."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valige Session keele seade. Session taaskäivitub, kui muudate oma keele seadet."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aukeratu zure hizkuntza ezarpena Session rako. Session berrabiaraziko da hizkuntza ezarpena aldatzen duzunean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیم زبان خود را برای Session انتخاب کنید. هنگامی که تنظیم زبان خود را تغییر دهید، Session مجدداً راه‌اندازی خواهد شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitse kielen asetus Session varten. Session käynnistyy uudelleen, kun muutat kieliasetuksesi."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pumili ng setting ng wika para sa Session. Ang Session ay magre-restart kapag binago mo ang setting ng wika."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez les paramètres de langue pour Session. Session redémarrera lorsque vous changerez les paramètres de langue."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elixe a configuración de idioma para Session. Session reiniciarase ao cambiar a configuración de idioma."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zaɓi saitin yarenku don Session. Session zai sake farawa lokacin da kuka canza saitin yaranku."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר את הגדרת השפה שלך עבור Session. Session יופעל מחדש כאשר תשנה את הגדרת השפה שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session के लिए अपनी भाषा सेटिंग चुनें. जब आप अपनी भाषा सेटिंग बदलेंगे तो Session पुनः प्रारंभ हो जाएगा।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Odaberite postavku jezika za Session. Session će se ponovno pokrenuti kada promijenite postavku jezika."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki a nyelvi beállításaidat a Session alkalmazáshoz. A Session újraindul, amikor megváltoztatod a nyelvi beállítást."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ընտրեք Ձեր լեզվի կարգավորումը Session-ի համար։ Session-ը վերագործարկվելու է, երբ փոխեք Ձեր լեզվի կարգավորումը։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pilih pengaturan bahasa Anda untuk Session. Session akan dimulai ulang ketika Anda mengubah pengaturan bahasa."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegli la lingua per Session. Session si riavvierà ogni volta che la cambierai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionの言語設定を選択してください。言語設定を変更するとSessionが再起動されます。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
