          "stringUnit" : {
            "state" : "translated",
            "value" : "คุณแน่ใจหรือไม่ว่าต้องการลบการสนทนาของคุณกับ <b>{name}</b>? ข้อความใหม่จาก <b>{name}</b> จะเริ่มการสนทนาใหม่"
          }
        },
