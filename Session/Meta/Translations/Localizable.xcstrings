    "confirmPromotionDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنتم متأكدون؟ لا يمكن خفض رتبة المسؤولين أو إزالتهم من المجموعة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Əminsiniz? Adminlərin vəzifəsini azaltmaq və ya adminləri qrupdan xaric etmək mümkün deyil."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jste si jistí? Správci nemohou být ponížení ani odebráni ze skupiny."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bist du sicher? Administratoren können nicht herabgestuft oder aus der Gruppe entfernt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Are you sure? Admins cannot be demoted or removed from the group."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro? Los admins no pueden ser degradados ni eliminados del grupo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás seguro? Los administradores no pueden ser degradados ni eliminados del grupo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آیا مطمئنید؟ مدیران را نمی‌توان عزل یا از گروه حذف کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oletko varma? Järjestelmänvalvojia ei voida alentaa tai poistaa ryhmästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Êtes-vous sûr ? Les administrateurs ne peuvent pas être rétrogradés ou supprimés du groupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "क्या आप वाकई सुनिश्चित हैं? एडमिन को डिमोट या समूह से हटाया नहीं जा सकता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Biztos vagy benne? Az adminisztrátorokat nem lehet lefokozni vagy eltávolítani a csoportból."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sei sicuro? Gli amministratori non possono essere retrocessi né rimossi dal gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "本当によろしいですか？管理者は降格またはグループから削除できません。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင် သေချာပါသလား။ စီမံခန့်ခွဲသူများကို အဖွဲ့မှ အဆင့်လျှော့ချခြင်း သို့မဟုတ် ဖယ်ရှားခြင်း မပြုနိုင်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker? Administratorer kan ikke degraderes eller fjernes fra gruppen."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker? Administratorer kan ikke degraderes eller fjernes fra gruppen."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weet je het zeker? Beheerders kunnen niet worden gedegradeerd of uit de groep worden verwijderd."
