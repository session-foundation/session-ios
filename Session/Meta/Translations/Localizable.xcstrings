    "proBadgesDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اظهروا دعمكم لـ Session من خلال شارة حصرية بجانب اسم العرض الخاص بكم."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran adınızın yanında eksklüziv bir nişanla Session tətbiqini dəstəklədiyinizi göstərin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyjádřete svou podporu Session pomocí exkluzivního odznaku vedle svého zobrazovaného jména."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeige deine Unterstützung für Session mit einem exklusiven Abzeichen neben deinem Anzeigenamen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Show your support for Session with an exclusive badge next to your display name."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demuestra tu apoyo a Session con una insignia exclusiva junto a tu nombre de pantalla."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demuestra tu apoyo a Session con una insignia exclusiva junto a tu nombre de pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حمایت خود را از Session با یک نشان ویژه در کنار نام نمایهٔ خود نشان دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Näytä tukesi sovellukselle Session ainutlaatuisella tunnuksella näyttönimesi vieressä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Affichez votre soutien à Session avec un badge exclusif, à côté de votre nom d'affichage."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने डिस्प्ले नाम के पास एक विशेष बैज के साथ Session के लिए अपना समर्थन दिखाएं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutassa ki a támogatását a(z) Session iránt egy exkluzív kitűzővel a megjelenítendő neve mellett."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostra il tuo supporto per Session con un badge esclusivo accanto al tuo nome visibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示名の横にある限定バッジで Session をサポートしていることを示してください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင့်ပရိုဖိုင်အမည်ဘေးရှိ သီးသန့်တံဆိပ်ဖြင့် Session တွက် သင်၏ ပံ့ပိုးမှုကို ပြသပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis at du støtter Session med et eksklusivt merke ved siden av visningsnavnet ditt."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis at du støtter Session med et eksklusivt merke ved siden av visningsnavnet ditt."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toon je steun voor Session met een exclusieve badge naast je schermnaam."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vis at du støtter Session med et eksklusivt merke ved siden av visningsnavnet ditt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pokaż swoje wsparcie dla Session ekskluzywną odznaką obok swojej nazwy wyświetlanej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre seu apoio ao Session com um emblema exclusivo ao lado do seu nome de exibição."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mostre seu apoio ao Session com um emblema exclusivo ao lado do seu nome de exibição."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arată susținerea ta pentru Session cu o insignă exclusivă afișată lângă numele tău."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Поддержите Session, добавив эксклюзивный значок рядом с вашим именем."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visa ditt stöd för Session med ett exklusivt märke bredvid ditt visningsnamn."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünen adınızın yanında özel bir rozetle Session uygulamasını desteklediğinizi gösterin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Продемонструйте свою підтримку Session з ексклюзивним значком поруч з власним іменем."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过你的显示名称旁边的专属徽章，展示你对 Session 的支持。"
          }
        }
      }
    },
