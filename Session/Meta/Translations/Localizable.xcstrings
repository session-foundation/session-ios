          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je betaling is succesvol verwerkt, maar er is een fout opgetreden bij het {action_type} van je Pro-status.<br/><br/>Controleer je netwerkverbinding en probeer het opnieuw."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
