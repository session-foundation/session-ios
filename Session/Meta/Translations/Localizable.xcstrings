        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "វាអាចជាឈ្មោះដែលជាការពិតរបស់អ្នក ឬឈ្មោះត្រួសត្រាយ ឬអ្វីដែលអ្នកចូលចិត្ត - និងអ្នកអាចផ្លាស់ប្តូរជានិច្ចកាល។"
