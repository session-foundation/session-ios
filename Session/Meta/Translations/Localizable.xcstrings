    "attachmentsWarning" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aanhegsels wat jy stoor kan deur ander programme op jou toestel verkry word."
