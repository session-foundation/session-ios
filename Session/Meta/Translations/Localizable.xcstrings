        },
        "sw" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je, una uhakika unataka kufuta data yako kutoka kwenye mtandao? Ukiendelea, hutakuwa na uwezo wa kurejesha ujumbe au anwani zako."
