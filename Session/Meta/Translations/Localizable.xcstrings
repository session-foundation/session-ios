    "recoveryPasswordDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام كلمة الاسترداد لتحميل حسابكم على أجهزة جديدة.<br/><br/>لا يمكن استرداد الحساب بدون كلمة الاسترداد. تأكدوا من حفظها في مكان آمن ومحمي — و<b>لا تشاركوها مع أي شخص</b>."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hesabınızı yeni cihazlara yükləmək üçün geri qaytarma parolunuzu istifadə edin.<br/><br/>Geri qaytarma parolunuz olmadan hesabınız geri qaytarıla bilməz. Parolu təhlükəsiz və etibarlı yerdə saxladığınıza əmin olun və <b>heç kəslə paylaşmayın</b>."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Použijte své heslo pro obnovení pro načtení účtu na nových zařízeních.<br/><br/>Bez hesla pro obnovení nelze obnovit účet. Ujistěte se, že je uložené na bezpečném místě — a <b>nesdílejte ho s nikým</b>."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende dein Wiederherstellungspasswort, um deinen Account auf neue Geräten zu laden.<br/><br/>Dein Account kann ohne dein Wiederherstellungspasswort nicht wiederhergestellt werden. Stelle sicher, dass es an einem sicheren Ort aufbewahrt ist – und <b>teile es niemandem mit</b>."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Χρησιμοποιήστε τον κωδικό ανάκτησης για να φορτώσετε τον λογαριασμό σας σε νέες συσκευές.<br/><br/>Ο λογαριασμός σας δεν μπορεί να ανακτηθεί χωρίς τον κωδικό ανάκτησης. Βεβαιωθείτε ότι τον αποθηκεύσατε σε ασφαλές μέρος — και <b>μην τον μοιραστείτε με κανέναν</b>."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use your recovery password to load your account on new devices.<br/><br/>Your account cannot be recovered without your recovery password. Make sure it's stored somewhere safe and secure — and <b>don't share it with anyone</b>."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu contraseña de recuperación para cargar tu cuenta en nuevos dispositivos.<br/><br/>Tu cuenta no se puede recuperar sin tu contraseña de recuperación. Asegúrate de que esté guardada en un lugar protegido y seguro, y <b>no la compartas con nadie</b>."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa tu contraseña de recuperación para cargar tu cuenta en nuevos dispositivos.<br/><br/>Tu cuenta no se puede recuperar sin tu contraseña de recuperación. Asegúrate de que esté guardada en un lugar seguro y <b>no la compartas con nadie</b>."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "از رمز بازیابی خود برای بارگیری حسابتان در دستگاه‌های جدید استفاده کنید.<br/><br/>حساب کاربری شما بدون رمز بازیابی شما قابل بازیابی نیست. مطمئن شوید که آن را در جایی امن و مطمئن نگه می‌دارید — و <b>آن را با هیچ‌کس به اشتراک نگذارید</b>."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Käytä palautussalasanaasi ladataksesi tilisi uusiin laitteisiin.<br/><br/>Tiliäsi ei voida palauttaa ilman palautussalasanaa. Varmista, että se on tallessa turvallisessa paikassa — äläkä <b>jaa sitä kenellekään</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez votre mot de passe de récupération pour charger votre compte sur de nouveaux appareils.<br/><br/>Votre compte ne peut pas être récupéré sans votre mot de passe de récupération. Assurez-vous qu'il soit stocké en lieu sûr et sécurisé ;— et <b>ne le partagez avec personne</b>."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने खाते को नए डिवाइस पर लोड करने के लिए अपने रिकवरी पासवर्ड का उपयोग करें।<br/><br/>आपका खाता बिना रिकवरी पासवर्ड के पुनर्प्राप्त नहीं किया जा सकता है। सुनिश्चित करें कि यह किसी सुरक्षित और संरक्षित स्थान पर संग्रहीत हो — और <b>इसे किसी के साथ साझा न करें</b>।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visszaállítási jelszavaddal új eszközökön is betöltheted a fiókodat.<br/><br/>A fiókod nem állítható vissza a visszaállítási jelszó nélkül. Ügyelj rá, hogy biztonságos helyen tárold — és <b>ne oszd meg senkivel</b>."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza la tua password di recupero per caricare il tuo account su nuovi dispositivi.<br/><br/>Il tuo account non può essere recuperato senza la tua password di recupero. Assicurati che sia conservata in un luogo sicuro e protetto — e <b>non condividerla con nessuno</b>."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リカバリパスワードを使用して、新しいデバイスでアカウントを読み込みます。<br/><br/>リカバリパスワードがないとアカウントを復元できません。安全な場所に保管し、<b>誰とも共有しないでください</b>。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복구 비밀번호를 사용해 다른 기기에서 계정을 불러올 수 있습니다. <br/><br/>복구 비밀번호가 없으면 계정을 불러올 수 없습니다. 안전한 곳에 보관하고 <b>다른 사람이 볼 수 없게 하세요</b>."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "စက်အသစ်များတွင် သင့်အကောင့်ကို ဖွင့်ရန် သင်၏ ပြန်လည်ရယူရေး စကားဝှက်ကို အသုံးပြုပါ။<br/><br/>သင်၏ ပြန်လည်ရယူရေး စကားဝှက် မရှိဘဲ သင့်အကောင့်ကို ပြန်လည်ရယူ၍ မရနိုင်ပါ။ ၎င်းကို လုံခြုံစိတ်ချရသော နေရာတစ်ခုတွင် သိမ်းဆည်းထားပါ — <b>မည်သူ့ကိုမျှ မမျှဝေပါနှင့်</b>။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk gjenopprettingspassordet ditt til å laste inn kontoen din på nye enheter.<br/><br/>Kontoen din kan ikke gjenopprettes uten dette passordet. Sørg for at det er lagret på et trygt og sikkert sted — og <b>ikke del det med noen</b>."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk gjenopprettingspassordet ditt til å laste inn kontoen din på nye enheter.<br/><br/>Kontoen din kan ikke gjenopprettes uten dette passordet. Sørg for at det er lagret på et trygt og sikkert sted — og <b>ikke del det med noen</b>."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik uw herstelwachtwoord om uw account op nieuwe apparaten te laden.<br/><br/>Uw account kan niet worden hersteld zonder uw herstelwachtwoord. Zorg ervoor dat het ergens veilig is opgeslagen – en <b>deel het met niemand</b>."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bruk gjenopprettingspassordet ditt til å laste inn kontoen din på nye enheter.<br/><br/>Kontoen din kan ikke gjenopprettes uten dette passordet. Sørg for at det er lagret på et trygt og sikkert sted — og <b>ikke del det med noen</b>."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Użyj swojego hasła odzyskiwania, by załadować swoje konto na nowych urządzeniach.<br/><br/>Twoje konto nie może być odzyskane bez tego hasła. Upewnij się, że przechowujesz je w bezpiecznym miejscu – i <b>nie ujawniaj go nikomu</b>."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use sua senha de recuperação para carregar sua conta em novos dispositivos.<br/><br/>Sua conta não pode ser recuperada sem sua senha de recuperação. Certifique-se de armazená-la em um lugar seguro e protegido — e <b>não a compartilhe com ninguém</b>."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a sua palavra-passe de recuperação para carregar a sua conta em novos dispositivos.<br/><br/>A sua conta não pode ser recuperada sem a sua palavra-passe de recuperação. Guarde-a num local seguro — e <b>não a partilhe com ninguém</b>."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folosește parola de recuperare pentru a încărca contul tău pe dispozitive noi.<br/><br/>Contul nu poate fi recuperat fără parola de recuperare. Asigură-te că este stocată într-un loc sigur și securizat — și <b>nu o împărtăși cu nimeni</b>."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используйте пароль восстановления, чтобы открыть свой аккаунт на новых устройствах.<br/><br/>Аккаунт нельзя восстановить без пароля восстановления. Убедитесь, что этот пароль хранится в безопасном месте, и <b>не делитесь им ни с кем</b>."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Använd ditt återställningslösenord för att ladda ditt konto på nya enheter.<br/><br/>Ditt konto kan inte återställas utan ditt återställningslösenord. Se till att det lagras på en säker och trygg plats — och <b>dela det inte med någon</b>."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kurtarma şifrenizi kullanarak hesabınızı yeni cihazlara yükleyin.<br/><br/>Kurtarma şifreniz olmadan hesabınız kurtarılamaz. Şifrenizi güvenli bir yerde sakladığınızdan emin olun ve <b>kimseyle paylaşmayın</b>."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Використовуйте пароль для відновлення для завантаження свого облікового запису на нових пристроях.<br/><br/>Ваш обліковий запис не може бути відновлений без пароля для відновлення. Переконайтеся, що він зберігається у надійному місці та <b>не передавайте його нікому</b>."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用您的恢复密码在新设备上加载您的帐户。<br/><br/>没有您的恢复密码，无法恢复您的帐户。请确保将其存储在安全的地方，并且<b>不要与任何人共享</b>。"
          }
        }
      }
