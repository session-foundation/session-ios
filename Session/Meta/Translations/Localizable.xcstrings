    "warningIosVersionEndingSupport" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انتهى دعم نظام iOS 15. يرجى التحديث إلى iOS 16 أو إصدار أحدث للاستمرار في تلقي تحديثات التطبيق."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podpora pro iOS 15 byla ukončena. Aktualizujte na iOS 16 nebo novější verzi, abyste mohli i nadále dostávat aktualizace aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Unterstützung für iOS 15 wurde beendet. Aktualisieren Sie auf iOS 16 oder neuer, um weiterhin App-Updates zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support for iOS 15 has ended. Update to iOS 16 or later to continue receiving app updates."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Support for iOS 15 has ended. Update to iOS 16 or later to continue receiving app updates."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La compatibilidad con iOS 15 ha finalizado. Actualiza a iOS 16 o una versión posterior para continuar recibiendo actualizaciones de la aplicación."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "پشتیبانی از iOS 15 به پایان رسیده است. برای ادامهٔ دریافت به‌روزرسانی‌های برنامه، به iOS 16 یا بالاتر به‌روزرسانی کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tuki iOS 15:lle on päättynyt. Päivitä iOS 16:een tai uudempaan saadaksesi edelleen sovelluspäivityksiä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La prise en charge d’iOS 15 est terminée. Mettez à jour vers iOS 16 ou une version ultérieure pour continuer à recevoir les mises à jour de l’application."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 15 के लिए समर्थन समाप्त हो गया है। ऐप अपडेट प्राप्त करना जारी रखने के लिए iOS 16 या बाद के संस्करण में अपडेट करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az iOS 15 támogatása megszűnt. Frissítsen iOS 16-ra vagy újabb verzióra az alkalmazásfrissítések fogadásának folytatásához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il supporto per iOS 15 è terminato. Aggiorna a iOS 16 o versioni successive per continuare a ricevere aggiornamenti dell'app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 15 のサポートは終了しました。アプリの更新を受け取るには、iOS 16 以降にアップデートしてください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 15 အတွက် ပံ့ပိုးမှု ပြီးဆုံးသွားပါပြီ။ အက်ပ် အပ်ဒိတ်များကို ဆက်လက်ရယူရန် iOS 16 သို့မဟုတ် ထို့ထက်နောက်ပိုင်းဗားရှင်းသို့ အပ်ဒိတ်လုပ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtten for iOS 15 er avsluttet. Oppdater til iOS 16 eller nyere for å fortsette å motta appoppdateringer."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtten for iOS 15 er avsluttet. Oppdater til iOS 16 eller nyere for å fortsette å motta appoppdateringer."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De ondersteuning voor iOS 15 is beëindigd. Werk bij naar iOS 16 of hoger om app-updates te blijven ontvangen."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Støtten for iOS 15 er avsluttet. Oppdater til iOS 16 eller nyere for å fortsette å motta appoppdateringer."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zakończono obsługę iOS 15. Zaktualizuj do iOS 16 lub nowszej wersji, aby nadal otrzymywać aktualizacje aplikacji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O suporte para iOS 15 foi encerrado. Atualize para o iOS 16 ou superior para continuar recebendo atualizações do app."
