        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Възникна неизвестна грешка и вашите данни не бяха изтрити. Искате ли да изтриете данните си само от това устройство?"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "একটি অজানা ত্রুটি ঘটেছে এবং আপনার ডেটা মোছা হয়নি। আপনি কি শুধুমাত্র এই ডিভাইস থেকে আপনার ডেটা মুছে ফেলতে চান?"
