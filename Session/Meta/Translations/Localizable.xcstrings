    "launchOnStartupDisabledDesktop" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم التحكم في هذا الإعداد من قبل النظام الخاص بكم على لينُكس. لتمكين التشغيل التلقائي، أضف Session إلى تطبيقات بدء التشغيل لديكم في إعدادات النظام."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu ayar, Linux-dakı sisteminiz tərəfindən idarə olunur. Avtomatik açılışı fəallaşdırmaq üçün sistem ayarlarında Session tətbiqini açılış tətbiqlərinizə əlavə edin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toto nastavení spravuje váš systém s Linuxem. Chcete-li povolit automatické spuštění, přidejte Session do spouštěných aplikací v nastavení systému."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Einstellung wird unter Linux von Ihrem System verwaltet. Um den automatischen Start zu aktivieren, fügen Sie Session in den Systemeinstellungen zu Ihren Autostart-Anwendungen hinzu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This setting is managed by your system on Linux. To enable automatic startup, add Session to your startup applications in system settings."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuración está gestionada por tu sistema en Linux. Para habilitar el inicio automático, añade Session a tus aplicaciones de inicio en la configuración del sistema."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta configuración está gestionada por tu sistema en Linux. Para habilitar el inicio automático, añade Session a tus aplicaciones de inicio en la configuración del sistema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در لینوکس، سیستم شما این تنظیم را مدیریت می‌کند. برای فعال‌کردن آغازبه‌کار خودکار، Session را به برنامه‌های آغازبه‌کار خودکار در تنظیمات سیستم اضافه کنید."
