    "proAllSetDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تحديث وصولكم إلى Session Pro! سيتم إصدار فاتورة لكم عند تجديد Pro تلقائيًا في <b>{date}</b>."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session Pro erişiminiz güncəllənib! Pro abunəliyiniz <b>{date}</b> tarixində avtomatik yeniləndiyi zaman ödəniş haqqı alınacaq."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš přístup k Session Pro byl aktualizován! Účtování proběhne při automatickém prodloužení Pro dne <b>{date}</b>."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Zugang zu Session Pro wurde aktualisiert! Die Abrechnung erfolgt, wenn Pro am <b>{date}</b> automatisch verlängert wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Session Pro access was updated! You will be billed when Pro is automatically renewed on <b>{date}</b>."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Tu acceso a Session Pro fue actualizado! Se te cobrará cuando Pro se renueve automáticamente el <b>{date}</b>."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Tu acceso a Session Pro fue actualizado! Se te cobrará cuando Pro se renueve automáticamente el <b>{date}</b>."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Session Pro شما به‌روزرسانی شد! هنگام تمدید خودکار Pro در <b>{date}</b> صورت‌حساب شما محاسبه می‌شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session Pro-palvelusi on päivitetty! Maksu veloitetaan automaattisesti Pro-tilauksesi uusimisen yhteydessä <b>{date}</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre accès Session Pro a été mis à jour ! Vous serez facturé lorsque Pro sera automatiquement renouvelé le <b>{date}</b>."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी Session Pro पहुँच अपडेट कर दी गई है! आपको <b>{date}</b> को Pro के स्वचालित रूप से नवीनीकरण के समय बिल भेजा जाएगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) Session Pro hozzáférésed frissítve lett! A számlázás akkor történik majd, amikor a(z) Pro automatikusan megújul <b>{date}</b> napján."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
