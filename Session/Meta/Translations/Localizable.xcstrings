        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je nám líto, že vaše zkušenost se Session <br/>nebyla ideální. Ocenili bychom, kdybyste <br/>věnovali chvíli vyplnění krátkého dotazníku"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es tut uns leid zu hören, dass deine Erfahrung mit Session nicht ideal war. Wir würden uns freuen, wenn du dir einen Moment Zeit nimmst und deine Gedanken in einer kurzen Umfrage mit uns teilst."
