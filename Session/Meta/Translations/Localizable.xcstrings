        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tämä asetus on järjestelmän hallinnoima Linuxissa. Ota automaattinen käynnistys käyttöön lisäämällä Session käynnistyssovelluksiin järjestelmäasetuksissa."
