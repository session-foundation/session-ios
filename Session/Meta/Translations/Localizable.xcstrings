    "proExpiredDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "للأسف، انتهت صلاحية وصولكم إلى Pro.<br/>جدّدوا لإعادة تفعيل الميزات والفوائد الحصرية في Session Pro Beta."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Təəssüf ki, Pro erişiminizin istifadə müddəti bitib.<br/>Session Pro üzrə eksklüziv imtiyazları və özəllikləri təkrar aktivləşdirmək üçün yeniləyin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bohužel, váš tarif Pro vypršel.<br/>Prodlužte jej, abyste znovu získali přístup k exkluzivním výhodám a funkcím Session Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Leider ist dein Pro-Zugang abgelaufen.<br/>Verlängere ihn, um die exklusiven Vorteile und Funktionen der Session Pro Beta wieder zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unfortunately, your Pro access has expired.<br/>Renew to reactivate the exclusive perks and features of Session Pro Beta."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lamentablemente, tu acceso Pro ha vencido.<br/>Renuévalo para reactivar los beneficios y funciones exclusivas de Session Pro Beta."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lamentablemente, tu acceso Pro ha vencido.<br/>Renuévalo para reactivar los beneficios y funciones exclusivas de Session Pro Beta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متأسفانه، دسترسی Pro شما به اتمام رسیده است.<br/>برای فعال‌سازی مجدد مزایا و قابلیت‌های انحصاری Session Pro بتا، آن را تمدید کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Valitettavasti Pro-tilisi käyttöoikeus on vanhentunut.<br/>Uusi tilaus aktivoidaksesi uudelleen Session Pro Betan eksklusiiviset edut ja ominaisuudet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Malheureusement, votre accès Pro a expiré.<br/>Renouvelez-le pour réactiver les avantages et fonctionnalités exclusifs de Session Pro Beta."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "दुर्भाग्यवश, आपकी Pro पहुँच समाप्त हो गई है।<br/>Session Pro बीटा के विशेष लाभों और सुविधाओं को पुनः सक्रिय करने के लिए नवीनीकृत करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sajnáljuk, a(z) Pro hozzáférésed lejárt.<br/>Megújítással újra elérheted a(z) Session Pro Beta exkluzív előnyeit és funkcióit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Purtroppo, il tuo accesso Pro è scaduto.<br/>Rinnova per riattivare i vantaggi e le funzionalità esclusive di Session Pro Beta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "申し訳ありませんが、Pro のアクセスは期限切れとなりました。<br/>Session Pro Beta の限定特典と機能を再度有効化するには、更新してください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဝမ်းနည်းပါသည်။ သင်၏ Pro အသုံးပြုခွင့် သက်တမ်းကုန်ဆုံးသွားပါပြီ။<br/>Session Pro Beta ၏ သီးသန့် အကျိုးခံစားခွင့်များနှင့် လုပ်ဆောင်ချက်များကို ပြန်လည်အသက်သွင်းရန် သက်တမ်းတိုးပါ။"
          }
