    "proUserProfileModalCallToAction" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تودون الاستفادة أكثر من Session?<br/>قوموا بالترقية إلى Session Pro Beta لتجربة مراسلة أقوى."
          }
