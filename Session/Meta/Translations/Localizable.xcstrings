    "proUnsuccessfulRenewalDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذر تجديد وصولكم إلى Pro بسبب مشكلة في الدفع في {platform_account}. يُرجى التحقق من حالة الدفع على {platform_store}.<br/><br/>سيظل وصولكم إلى Pro نشطًا ويمكنكم متابعة إجراء تغييرات الفوترة بينما يعيد {platform_store} محاولة تحصيل دفعتك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Pro access couldn’t be renewed due to a payment issue with your {platform_account}. Please check the status of your payment on the {platform_store}.<br/><br/>Your Pro access will remain active and you may continue to make billing changes while the {platform_store} retries your payment."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu acceso Pro no pudo ser renovado debido a un tema de tu pago con tu {platform_account}. Por favor revisa el estado de tu pago en {platform_store}.<br/><br/>Tu acceso Pro se mantendrá activo y podrás continuar realizando cambios en la facturación mientras {platform_store} reintenta tu pago."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Pro شما به دلیل مشکلی در پرداخت با {platform_account} تمدید نشد. لطفاً وضعیت پرداخت خود را در {platform_store} بررسی کنید.<br/><br/>دسترسی Pro شما فعال خواهد ماند و تا زمانی که {platform_store} مجدداً پرداخت شما را مجدداً پردازش می‌کند، می‌توانید به ایجاد تغییرات در صورت‌حساب ادامه دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre accès Pro n'a pas pu être renouvelé à cause d'un problème de paiement lié à votre {platform_account}. Merci de vérifier le status de votre paiement sur le {platform_store}. <br/><br/>Votre accès Pro restera actif et vous pourrez continuer de faire des changements de facturations pendant que le {platform_store} réessaye le paiement."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်၏ {platform_account} တွင် ငွေပေးချေမှု ပြဿနာတစ်ခု ရှိနေသောကြောင့် သင်၏ Pro အသုံးပြုခွင့်ကို သက်တမ်းတိုး၍ မရပါ။ ကျေးဇူးပြု၍ {platform_store} တွင် သင်၏ ငွေပေးချေမှု အခြေအနေကို စစ်ဆေးပါ။<br/><br/>{platform_store} မှ သင်၏ ငွေပေးချေမှုကို ထပ်မံကြိုးစားနေစဉ်အတွင်း သင်၏ Pro အသုံးပြုခွင့်သည် ဆက်လက်အသက်ဝင်နေမည်ဖြစ်ပြီး ငွေတောင်းခံမှုဆိုင်ရာ အပြောင်းအလဲများကိုလည်း ဆက်လက်လုပ်ဆောင်နိုင်ပါသည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ошибка продления доступа к Pro из-за проблемы с оплатой через {platform_account}. Пожалуйста, проверьте статус платежа на сайте {platform_store}.<br/><br/>Ваш доступ к Pro и платежной информации останется открыт, пока {platform_store} повторяет платёж."
          }
        }
      }
    },
    "proUpdateAccessDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيار الفوترة الحالي يمنحكم <b>{current_plan_length}</b> إضافية من وصول Pro. هل أنتم متيقِّنون من التبديل إلى خيار الفوترة <b>{selected_plan_length_singular}</b>؟<br/><br/>عند التحديث، سيتم تجديد وصول Pro تلقائيًا في <b>{date}</b> لمدة إضافية قدرها <b>{selected_plan_length}</b> من وصول Pro."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vaše aktuální fakturační možnost zahrnuje <b>{current_plan_length}</b> přístupu k Pro. Jste si jisti, že chcete přejít na fakturační možnost <b>{selected_plan_length_singular}</b>?<br/><br/>Po aktualizaci se váš přístup k Pro automaticky prodlouží <b>{date}</b> na dalších <b>{selected_plan_length}</b> přístupu k Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
