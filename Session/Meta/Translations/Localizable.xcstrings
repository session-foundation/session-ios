    "proImportantDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طلب استرداد الأموال نهائي. إذا تمت الموافقة، سيتم إلغاء وصولكم إلى Pro فورًا وستفقدون إمكانية الوصول إلى جميع ميزات Pro."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri ödəniş tələbi qətidir. Əgər təsdiqlənsə, Pro erişiminiz dərhal ləğv ediləcək və bütün Pro özəlliklərinə erişimi itirəcəksiniz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Žádost o vrácení peněz je konečná. Pokud bude schválena, váš přístup k Pro bude ihned zrušen a ztratíte přístup ke všem funkcím Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Anfordern einer Rückerstattung ist endgültig. Wenn sie genehmigt wird, wird dein Pro-Zugang sofort storniert und du verlierst den Zugriff auf alle Pro-Funktionen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Requesting a refund is final. If approved, your Pro access will be canceled immediately and you will lose access to all Pro features."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar un reembolso es definitivo. Si se aprueba, tu acceso Pro se cancelará de inmediato y perderás el acceso a todas las funciones de Pro."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar un reembolso es definitivo. Si se aprueba, tu acceso Pro se cancelará de inmediato y perderás el acceso a todas las funciones de Pro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "درخواست استرداد وجه نهایی است. اگر تأیید شود، دسترسی Pro شما بلافاصله لغو می‌شود و دسترسی به تمامی قابلیت‌های Pro را از دست خواهید داد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hyvityksen pyytäminen on lopullista. Jos pyyntö hyväksytään, Pro-käyttösi peruutetaan välittömästi ja menetät pääsyn kaikkiin Pro-ominaisuuksiin."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une demande de remboursement est définitive. Si elle est approuvée, votre accès Pro sera immédiatement annulé et vous perdrez l'accès à toutes les fonctionnalités Pro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "रिफंड का अनुरोध अंतिम होता है। यदि स्वीकृत हो जाता है, तो आपकी Pro पहुँच तुरंत रद्द कर दी जाएगी और आप सभी Pro सुविधाओं की पहुँच खो देंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visszatérítés kérése végleges. Ha jóváhagyják, a(z) Pro hozzáférése azonnal megszűnik, és elveszíti a(z) Pro funkciókhoz való hozzáférést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La richiesta di rimborso è definitiva. Se approvata, il tuo accesso Pro verrà annullato immediatamente e perderai l'accesso a tutte le funzionalità Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "返金リクエストは最終的なものです。承認された場合、Pro のアクセスは即座にキャンセルされ、すべての Pro 機能へのアクセスを失います。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ငွေပြန်အမ်းရန် တောင်းဆိုခြင်းသည် နောက်ဆုံးအတည်ဖြစ်သည်။ အတည်ပြုပါက သင်၏ Pro အသုံးပြုခွင့်ကို ချက်ချင်း ပယ်ဖျက်ပြီး Pro လုပ်ဆောင်ချက်အားလုံးကို အသုံးပြုခွင့် ဆုံးရှုံးသွားပါမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forespørsel om refusjon er endelig. Hvis den godkjennes, vil tilgangen din til Pro bli kansellert umiddelbart, og du mister tilgang til alle Pro-funksjoner."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forespørsel om refusjon er endelig. Hvis den godkjennes, vil tilgangen din til Pro bli kansellert umiddelbart, og du mister tilgang til alle Pro-funksjoner."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het aanvragen van een terugbetaling is definitief. Indien goedgekeurd, wordt je toegang tot Pro onmiddellijk geannuleerd en verlies je toegang tot alle Pro-functies."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forespørsel om refusjon er endelig. Hvis den godkjennes, vil tilgangen din til Pro bli kansellert umiddelbart, og du mister tilgang til alle Pro-funksjoner."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Żądanie zwrotu jest ostateczne. Jeśli zostanie zatwierdzone, Twój dostęp do Pro zostanie natychmiast anulowany i utracisz dostęp do wszystkich funkcji Pro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar um reembolso é definitivo. Se aprovado, seu acesso ao Pro será cancelado imediatamente e você perderá o acesso a todos os recursos do Pro."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitar um reembolso é definitivo. Se aprovado, seu acesso Pro será cancelado imediatamente e você perderá o acesso a todos os recursos Pro."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solicitarea unei rambursări este definitivă. Dacă este aprobată, accesul tău Pro va fi anulat imediat și vei pierde accesul la toate funcționalitățile Pro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запрос на возврат средств является окончательным. В случае одобрения ваш доступ к Pro будет немедленно аннулирован, и вы потеряете доступ ко всем функциям Pro."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Att begära återbetalning är slutgiltigt. Om den godkänns kommer din åtkomst till Pro att avbrytas omedelbart och du kommer att förlora åtkomst till alla Pro-funktioner."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Geri ödeme talebi kesindir. Onaylanması durumunda, Pro erişiminiz hemen iptal edilecek ve tüm Pro özelliklerine erişiminizi kaybedeceksiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запит на повернення коштів є остаточним. Якщо його буде схвалено, ваш доступ до Pro буде негайно скасовано, і ви втратите доступ до всіх функцій Pro."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "申请退款后将无法撤销。一旦通过，您的 Pro 访问权限将立即取消，您将无法再使用所有 Pro 功能。"
          }
        }
      }
    },
