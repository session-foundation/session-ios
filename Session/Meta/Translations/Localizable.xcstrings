        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်၏ Session Pro အသုံးပြုခွင့်ကို အပ်ဒိတ်လုပ်ပြီးပါပြီ။ Pro ကို <b>{date}</b> တွင် အလိုအလျောက် သက်တမ်းတိုးသောအခါ ကျသင့်ငွေကို ကောက်ခံပါမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
