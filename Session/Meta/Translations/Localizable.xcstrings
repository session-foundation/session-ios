        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renueva tu acceso Pro en el <b><span>sitio web de {platform_store}</span></b> utilizando la cuenta {platform_account} con la que te registraste para Pro."
