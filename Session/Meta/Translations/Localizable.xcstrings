    "supportDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل تواجهون مشكلة؟ تصفحوا مقالات المساعدة أو افتحوا تذكرة دعم لدى Session."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Problemlə üzləşmisiniz? Kömək məqalələrini oxuyun, ya da Session Dəstək ilə bir sorğu açın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Máte problémy? Projděte si články nápovědy nebo kontaktujte podporu Session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Probleme? Erkunde die Hilfeartikel oder öffne ein Ticket bei dem Session Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Having issues? Explore help articles or open a ticket with Session Support."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes problemas? Consulta los artículos de ayuda o abre un ticket con el soporte de Session."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Tienes problemas? Consulta los artículos de ayuda o abre un ticket con el soporte de Session."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشکلی دارید؟ مقالات راهنما را بررسی کنید یا در پشتیبانی Session یک درخواست باز کنید."
          }
        },
