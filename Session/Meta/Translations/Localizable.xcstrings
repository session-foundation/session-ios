          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ازآنجاکه شما از ابتدا برای Session Pro از طریق <b>{platform_store}</b> ثبت‌نام کردید، برای به‌روزرسانی دسترسی Pro خود باید از {platform_account} خود استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koska rekisteröidyit alun perin Session Pro-palveluun <b>{platform_store}</b>-palvelun kautta, sinun on käytettävä {platform_account}-tiliäsi päivittääksesi Pro-käyttöoikeutesi."
          }
        },
        "fr" : {
          "stringUnit" : {
