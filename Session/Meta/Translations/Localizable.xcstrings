            "value" : "Admin olduğunuz qruplar, avtomatik olaraq 300 üzvü dəstəkləmək üçün təkmilləşdirilir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skupiny, ve kterých jste správcem, jsou automaticky navýšeny na kapacitu až 300 členů."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gruppen, in denen du Administrator bist, werden automatisch erweitert, um bis zu 300 Mitglieder zu unterstützen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Groups you are an admin in are automatically upgraded to support 300 members."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos en los que eres admin se actualizan automáticamente para admitir hasta 300 miembros."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los grupos en los que eres administrador se actualizan automáticamente para admitir hasta 300 miembros."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "گروه‌هایی که شما در آن‌ها مدیر هستید، به‌صورت خودکار برای پشتیبانی از ۳۰۰ عضو ارتقا می‌یابند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ryhmäsi, joissa toimit ylläpitäjänä, päivitetään automaattisesti tukemaan 300 jäsentä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les groupes dont vous êtes administrateur sont automatiquement mis à niveau pour prendre en charge 300 membres."
          }
