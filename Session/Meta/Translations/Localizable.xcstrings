          "stringUnit" : {
            "state" : "translated",
            "value" : "Таны дэлгэцийн нэртэй хэрэглэгчид, бүлгүүд болон дагуулсан нийгэмлэгүүдэд таны харилцдаг."
          }
        },
        "ms" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nama Paparan anda boleh dilihat oleh pengguna, kumpulan dan komuniti yang anda berinteraksi dengan."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်ပြသထားသည့် အမည်ကို သုံးစွဲသူများ၊ အဖွဲ့များနှင့် သင်ပြောဆိုဆက်ဆံသော ကွန်မြူနတီများက မြင်နိုင်သည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visningsnavnet ditt er synlig for brukere, grupper og fellesskap du samhandler med."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visningsnavnet ditt er synlig for brukere, grupper og fellesskap du samhandler med."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uw weergeven naam is zichtbaar voor gebruikers, groepen en gemeenschappen waarmee u communiceert."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visningsnavnet ditt er synlig for brukere, grupper og fellesskap du samhandler med."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wyświetlana nazwa użytkownika jest widoczna dla użytkowników, grup i społeczności, z którymi użytkownik wchodzi w interakcje."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Nome de Exibição é visível para usuários, grupos e comunidades com os quais você interage."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu Nome de Exibição é visível para usuários, grupos e comunidades com os quais você interage."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Numele tău de afișare este vizibil utilizatorilor, grupurilor și comunităților cu care interacționezi."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше отображаемое имя видно пользователям, группам и сообществам, с которыми вы взаимодействуете."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt visningsnamn är synligt för användare, grupper och samhällen du interagerar med."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Görünen Adınız, etkileşimde bulunduğunuz kullanıcılar, gruplar ve topluluklar tarafından görülebilir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваше відображуване ім'я видно користувачам, групам і спільнотам, з якими ви взаємодієте."
          }
        },
        "ur-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "آپ کا ڈسپلے نام ان صارفین، گروپوں اور کمیونٹیوں کو نظر آتا ہے جن کے ساتھ آپ تعامل کرتے ہیں۔"
          }
        },
        "vi" : {
