    "groupMemberInvitedHistory" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت دعوة <b>{name}</b> للانضمام إلى المجموعة. تمت مشاركة سجل الدردشة لآخر 14 يومًا."
          }
        },
        "az" : {
          "stringUnit" : {
