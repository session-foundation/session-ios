      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ميزات جديدة قادمة قريبًا إلى Pro. اكتشفوا ما هو التالي في <b>خارطة طريق Pro</b> {icon}"
