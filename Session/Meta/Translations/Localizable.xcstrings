    "appIconAndNameChangeConfirmation" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتطلب تغيير أيقونة التطبيق واسمه إغلاق Session. سوف تستمر الإشعارات في استخدام أيقونة واسم Session الافتراضي."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tətbiq ikonunu və adını dəyişdirərkən Session bağlanılacaq. Bildirişlər, ilkin Session ikonunu və adını istifadə etməyə davam edəcək."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Canviar la icona i el nom de l'aplicació requereix que es tanqui Session. Les notificacions continuaran utilitzant la icona i nom de l'aplicació Session."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Změna ikony a názvu aplikace vyžaduje, aby byla aplikace Session zavřena. Oznámení budou nadále používat výchozí ikonu a název Session."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Ändern des App-Symbols und -Namens erfordert, dass Session beendet wird. Benachrichtigungen verwenden weiterhin das Standardsymbol und den Standardnamen von Session."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changing the app icon and name requires Session to be closed. Notifications will continue to use the default Session icon and name."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el icono y el nombre de la aplicación requiere cerrar Session. Las notificaciones seguirán utilizando el icono y nombre predeterminados de Session."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambiar el icono y el nombre de la aplicación requiere cerrar Session. Las notificaciones seguirán utilizando el icono y nombre predeterminados de Session."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغییر نماد و نام برنامه مستلزم بسته‌شدن Session است. اعلان‌ها همچنان از نماد و نام پیش‌فرض Session استفاده خواهند کرد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sovelluksen kuvakkeen ja nimen muuttaminen edellyttää, että Session suljetaan. Ilmoituksissa käytetään edelleen oletuskuvaketta ja -nimeä Session."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Changer l'icône et le nom de l'application nécessite la fermeture de Session. Les notifications continueront d'utiliser l'icône et le nom par défaut de Session."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ऐप आइकन और नाम बदलने के लिए Session को बंद करना आवश्यक है। सूचनाएं डिफ़ॉल्ट Session आइकन और नाम का उपयोग करना जारी रखेंगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás ikonjának és nevének módosításához be kell zárni a Session alkalmazást. Az értesítések továbbra is az alapértelmezett Session ikont és nevet fogják használni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La modifica dell'icona e del nome dell'app richiede la chiusura di Session. Le notifiche continueranno a mostrare l'icona e il nome predefiniti di Session."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アプリのアイコンと名前を変更するには Session を終了する必要があります。通知では引き続きデフォルトの Session のアイコンと名前が使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앱 아이콘 및 이름을 변경하려면 Session의 재시작이 필요합니다. 알림은 Session의 기본 아이콘 및 이름으로 표시됩니다."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "အက်ပ် အိုင်ကွန်နှင့် အမည်ကို ပြောင်းလဲရန် Session ကို ပိတ်ထားရပါမည်။ အသိပေးချက်များတွင် မူလ Session အိုင်ကွန်နှင့် အမည်ကို ဆက်လက် အသုံးပြုသွားပါမည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å endre app-ikon og -navn må Session lukkes. Varsler vil fortsatt bruke standardikonet og -navnet til Session."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å endre app-ikon og -navn må Session lukkes. Varsler vil fortsatt bruke standardikonet og -navnet til Session."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Om het app icoon en de naam te wijzigen moet Session afgesloten worden. Meldingen blijven het standaard Session pictogram en naam gebruiken."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "For å endre app-ikon og -navn må Session lukkes. Varsler vil fortsatt bruke standardikonet og -navnet til Session."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zmiana ikony i nazwy aplikacji wymaga zamknięcia aplikacji Session. Powiadomienia nadal będą używać domyślnej ikony i nazwy Session."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o ícone e o nome do aplicativo requer que o Session seja fechado. As notificações continuarão a usar o ícone e o nome padrão do Session."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alterar o ícone e nome da aplicação requer o encerramento do Session. As notificações continuarão a usar o ícone e nome predefinidos de Session."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schimbarea pictogramei și a numelui aplicației necesită închiderea Session. Notificările vor continua să folosească pictograma și numele implicit Session."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для изменения значка и названия приложения Session необходимо его закрыть. Уведомления продолжат использовать стандартные значок и название приложения Session."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "För att byta appikon och namn måste Session stängas. Aviseringar kommer fortsätta använda standardikonen och namnet för Session."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uygulama simgesini ve adını değiştirmek, Session uygulamasının kapatılmasını gerektirir. Bildirimler, varsayılan Session simgesini ve adını kullanmaya devam edecektir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зміна значка та назви застосунку потребує закриття Session. Сповіщення надходитимуть зі стандартною назвою та значком Session."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更改应用图标和名称需要关闭 Session。通知仍将使用默认的 Session 图标和名称。"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
