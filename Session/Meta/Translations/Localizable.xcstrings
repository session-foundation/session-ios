        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Willst du mehr aus Session herausholen?<br/>Upgrade auf Session Pro Beta für ein leistungsstärkeres Nachrichten-Erlebnis."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Want to get more out of Session?<br/>Upgrade to Session Pro Beta for a more powerful messaging experience."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres sacarle más provecho a Session?<br/>Actualiza a Session Pro Beta para una experiencia de mensajería más potente."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Quieres sacarle más provecho a Session?<br/>Actualiza a Session Pro Beta para una experiencia de mensajería más potente."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌خواهید بهرهٔ بیشتری از Session ببرید؟<br/>برای تجربه‌ٔ پیام‌رسانی قوی‌تر، به Session Pro بتا ارتقا دهید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Haluatko saada enemmän irti sovelluksesta Session?<br/>Päivitä Session Pro Beta -versioon saadaksesi tehokkaamman viestintäkokemuksen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
