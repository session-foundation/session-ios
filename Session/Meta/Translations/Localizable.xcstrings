    "proStatusLoadingDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جارٍ تحميل معلومات Pro الخاصة بكم. قد لا تتوفر بعض الإجراءات في هذه الصفحة حتى يكتمل التحميل."
