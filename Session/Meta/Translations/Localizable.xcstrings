          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your current billing option will grant an additional <b>{current_plan_length}</b> of Pro access when your next renewal occurs. Are you sure you want to switch to the <b>{selected_plan_length_singular}</b> billing option?<br/><br/>By updating, your Pro access will automatically renew on <b>{date}</b> for an additional <b>{selected_plan_length}</b> of Pro access."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu opción de facturación actual otorga <b>{current_plan_length}</b> de acceso Pro. ¿Seguro que deseas cambiar a la opción de facturación <b>{selected_plan_length_singular}</b>?<br/><br/>Al actualizar, tu acceso Pro se renovará automáticamente el <b>{date}</b> por <b>{selected_plan_length}</b> adicionales de acceso Pro."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu opción de facturación actual otorga <b>{current_plan_length}</b> de acceso Pro. ¿Seguro que deseas cambiar a la opción de facturación <b>{selected_plan_length_singular}</b>?<br/><br/>Al actualizar, tu acceso Pro se renovará automáticamente el <b>{date}</b> por <b>{selected_plan_length}</b> adicionales de acceso Pro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صورت‌حساب فعلی شما هنگام تمدید بعدی، <b>{current_plan_length}</b> دسترسی اضافی Pro به شما اعطا می‌کند. آیا مطمئنید می‌خواهید به صورت‌حساب <b>{selected_plan_length_singular}</b> تغییر دهید؟<br/><br/>با به‌روزرسانی، دسترسی Pro شما در <b>{date}</b> به‌صورت خودکار با <b>{selected_plan_length}</b> دسترسی اضافی Pro تمدید خواهد شد."
          }
