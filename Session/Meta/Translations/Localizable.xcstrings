        },
        "ku-TR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sema navê şifreya te yê derbasî, hûn navê hesabek xwe li sermasanayên nû radkebikin.<br/><br/>Em bi piştriyariyan navê şifreya te yê derbasî li cihê muşterî û aram bike berdewamde."
          }
