    "membersInviteNoContacts" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ليس لديكم أي جهات اتصال لدعوتها إلى هذه المجموعة.<br/>عودوا للخلف وادعوا أعضاء باستخدام معرف حسابهم أو ONS."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu qrupa dəvət edəcək kontaktınız yoxdur.<br/>Geri qayıdın və Hesab kimliyini və ya ONS-sini istifadə edərək üzvlər dəvət edin."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemáte žádné kontakty, které byste mohli pozvat do této skupiny.<br/>Vraťte se zpět později a pozvěte členy pomocí jejich ID účtu nebo ONS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast keine Kontakte, die du in diese Gruppe einladen könntest.<br/>Gehe zurück und lade Mitglieder über ihre Account-ID oder ONS ein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don’t have any contacts to invite to this group.<br/>Go back and invite members using their Account ID or ONS."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes contactos para invitar a este grupo.<br/>Regresa e invita miembros usando su ID de cuenta o ONS."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No tienes contactos para invitar a este grupo.<br/>Regresa e invita miembros usando su ID de cuenta o ONS."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما هیچ مخاطبی برای دعوت به این گروه ندارید.<br/>برگردید و اعضا را با استفاده از شناسهٔ حساب یا ONS دعوت کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sinulla ei ole kontakteja, joita kutsua tähän ryhmään.<br/>Palaa takaisin ja kutsu jäseniä heidän tilitunnuksellaan (Account ID) tai ONS-tunnuksellaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez aucun contact à inviter dans ce groupe.<br/> Revenez en arrière et invitez des membres en utilisant leur identifiant de compte ou leur ONS."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास इस समूह में आमंत्रित करने के लिए कोई संपर्क नहीं है।<br/>वापस जाएँ और सदस्यों को उनकी खाता आईडी या ONS का उपयोग करके आमंत्रित करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nincs kapcsolatod, akit meghívhatnál ebbe a csoportba.<br/>Lépj vissza, és hívj meg tagokat a Felhasználóazonosítójuk vagy ONS segítségével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai contatti da invitare in questo gruppo.<br/>Torna indietro e invita membri usando il loro ID utente o ONS."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このグループに招待できる連絡先がありません。<br/>戻って、アカウントIDまたはONSを使ってメンバーを招待してください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ဤအဖွဲ့သို့ ဖိတ်ခေါ်ရန် အဆက်အသွယ်များ မရှိသေးပါ။<br/>နောက်သို့ ပြန်သွားပြီး အဖွဲ့ဝင်များကို ၎င်းတို့၏ အကောင့် ID သို့မဟုတ် ONS ကို အသုံးပြု၍ ဖိတ်ခေါ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du har ingen kontakter å invitere til denne gruppen.<br/>Gå tilbake og inviter medlemmer ved å bruke kontoid eller ONS-en deres."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
