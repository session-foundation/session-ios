        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դա կարող է լինել ձեր իրական անունը, ծածկանունը կամ որևէ այլ բան, և դուք կարող եք այն փոխել ցանկացած պահի:"
