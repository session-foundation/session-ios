        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session tətbiqindən daha çox faydalanmaq istəyirsiniz?<br/>Daha güclü mesajlaşma təcrübəsi üçün Session Pro Betaya yüksəldin."
          }
