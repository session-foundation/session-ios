          "stringUnit" : {
            "state" : "translated",
            "value" : "Söhbət siyahınızda <b>Özünə Qeyd</b>i göstərmək istədiyinizə əminsiniz?"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estàs segur que vols mostrar <b>Nota a Si Mateix</b> a la teva llista de converses?"
