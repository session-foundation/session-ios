          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gall fod dy enw go iawn, alias, neu unrhyw enw arall wyt ti’n ei hoffi — ac fe elli di ei newid unrhyw bryd."
