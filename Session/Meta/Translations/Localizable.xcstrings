    "proLargerGroupsDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم ترقية أي مجموعة تكونون فيها مسؤولًا تلقائيًا لدعم 300 عضو."
          }
        },
        "az" : {
          "stringUnit" : {
