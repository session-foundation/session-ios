          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी Pro एक्सेस जानकारी अभी भी लोड हो रही है। आप इस प्रक्रिया के पूरी होने तक अपडेट नहीं कर सकते।"
