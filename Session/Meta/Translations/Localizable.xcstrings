        "lg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kino kiyinza kubeera erinnya lyo ddala, oba ky'okolaba kino fayiro y'omuntu goge okkoba. Era osobola okukikyusa ekiseera kyonna."
