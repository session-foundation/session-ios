    "refundNonOriginatorApple" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظرًا لأنكم تسجلتم في Session Pro من خلال حساب {platform_account} مختلف، فستحتاجون إلى استخدام <b><span>{platform_account}</span></b> هذا لتحديث وصولكم إلى Pro."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başda fərqli {platform_account} vasitəsilə Session Pro üçün qeydiyyatdan keçdiyinizə görə planınızı\nPro erişiminizi güncəlləmək üçün həmin <b><span>{platform_account}</span></b> platformasını istifadə etməlisiniz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protože jste si původně zaregistrovali Session Pro přes jiný {platform_account}, je třeba použít ten <b><span>{platform_account}</span></b>, abyste aktualizovali svůj přístup k Pro."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da du dich ursprünglich mit einem anderen {platform_account} für Session Pro angemeldet hast, musst du dieses <b><span>{platform_account}</span></b> verwenden, um deinen Pro-Zugang zu aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you originally signed up for Session Pro via a different {platform_account}, you'll need to use that <b><span>{platform_account}</span></b> to update your Pro access."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como te registraste originalmente en Session Pro con otra {platform_account}, deberás usar esa <b><span>{platform_account}</span></b> para actualizar tu acceso a Pro."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como te registraste originalmente en Session Pro con otra {platform_account}, deberás usar esa <b><span>{platform_account}</span></b> para actualizar tu acceso a Pro."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ازآنجاکه شما از ابتدا برای Session Pro از طریق یک {platform_account} دیگر ثبت‌نام کرده‌اید، برای به‌روزرسانی دسترسی Pro خود باید از همان <b><span>{platform_account}</span></b> استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koska rekisteröidyit alun perin Session Pro-palveluun eri {platform_account}-tilin kautta, sinun on käytettävä kyseistä <b><span>{platform_account}</span></b>-tiliä päivittääksesi Pro-käyttöoikeutesi."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comme vous vous êtes initialement inscrit à Session Pro via une autre {platform_account}, vous devez utiliser cet autre <b><span>{platform_account}</span></b> pour mettre à jour votre abonnement Pro."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चूंकि आपने मूल रूप से Session Pro के लिए पंजीकरण करते समय एक अलग {platform_account} का उपयोग किया था, इसलिए आपको अपनी Pro एक्सेस को अपडेट करने के लिए उसी <b><span>{platform_account}</span></b> का उपयोग करना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivel eredetileg egy másik {platform_account} fiókkal regisztrált a(z) Session Pro szolgáltatásra, ezt a <b><span>{platform_account}</span></b> fiókot kell használnia a(z) Pro hozzáférés frissítéséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiché ti sei registrato originalmente a Session Pro tramite un altro {platform_account}, dovrai usare quell'account <b><span>{platform_account}</span></b> per aggiornare il tuo accesso Pro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "元々 Session Pro に登録した別の {platform_account} 経由でサインアップしているため、その <b><span>{platform_account}</span></b> を使用して Pro アクセスを更新する必要があります。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်သည် မူလက Session Pro အတွက် အခြား {platform_account} မှတစ်ဆင့် စာရင်းသွင်းထားသောကြောင့် သင်၏ Pro အသုံးပြုခွင့်ကို အပ်ဒိတ်လုပ်ရန် ထို <b><span>{platform_account}</span></b> ကို အသုံးပြုရန် လိုအပ်ပါသည်။"
