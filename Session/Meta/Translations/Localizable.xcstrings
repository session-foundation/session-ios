    "adminStatusYou" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تغيير حالتكم كمسؤول. لمغادرة المجموعة، افتحوا إعدادات المحادثة واختاروا مغادرة المجموعة."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nemůžete změnit svůj stav správce. Chcete-li skupinu opustit, otevřete nastavení konverzace a vyberte možnost Opustit skupinu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst deinen eigenen Administratorstatus nicht ändern. Um die Gruppe zu verlassen, öffne die Unterhaltungseinstellungen und wähle Gruppe verlassen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You cannot change your admin status. To leave the group, open the conversation settings and select Leave Group."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes cambiar tu estado de admin. Para salir del grupo, abre los ajustes de la conversación y selecciona Salir del grupo."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No puedes cambiar tu estado de administrador. Para salir del grupo, abre los ajustes de la conversación y selecciona Salir del grupo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "شما نمی‌توانید وضعیت مدیریت خود را تغییر دهید. برای ترک گروه، تنظیمات مکالمه را باز کنید و «ترک گروه» را انتخاب کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Et voi muuttaa ylläpitäjäasemasi. Poistuaksesi ryhmästä, avaa keskustelun asetukset ja valitse Poistu ryhmästä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas modifier votre statut d’administrateur. Pour quitter le groupe, ouvrez les paramètres de la conversation et sélectionnez Quitter le groupe."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप अपना एडमिन स्टेटस नहीं बदल सकते। समूह छोड़ने के लिए, बातचीत सेटिंग्स खोलें और समूह छोड़ें चुनें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem módosíthatod az adminisztrátori státuszodat. A csoport elhagyásához nyisd meg a beszélgetés beállításait, és válaszd a Csoport elhagyása lehetőséget."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non puoi modificare il tuo stato di amministratore. Per uscire dal gruppo, apri le impostazioni della conversazione e seleziona Esci dal gruppo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の管理者ステータスは変更できません。グループを退出するには、会話の設定を開いて「グループを退出」を選択してください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "သင်၏ အက်ဒမင် အခြေအနေကို သင် မပြောင်းလဲနိုင်ပါ။ အဖွဲ့မှ ထွက်ရန် စကားဝိုင်း ဆက်တင်များကို ဖွင့်ပြီး \"အဖွဲ့မှ ထွက်မည်\" ကို ရွေးပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke endre din egen administratorstatus. For å forlate gruppen, åpne samtaleinnstillingene og velg Forlat gruppe."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kan ikke endre din egen administratorstatus. For å forlate gruppen, åpne samtaleinnstillingene og velg Forlat gruppe."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
