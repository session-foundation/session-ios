    "giphyWarningDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session sal aan Giphy koppel om soekresultate te verskaf. Jy sal nie volledige metadata beskerming hê as jy GIFs stuur nie."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session سيتصل بمنصة Giphy لتقديم نتائج البحث. لن يكون لديكم حماية كاملة للبيانات الوصفية عند إرسال الصور المتحركة GIFs."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session axtarış nəticələrini təqdim etmək üçün Giphy-ə bağlanacaq. GIF göndərərkən tam meta veri qorumasına sahib olmayacaqsınız."
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ګیپہ ژن چی نازردہ ژن انجام گی ییگر کریں."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session падключыцца да Giphy для прадастаўлення вынікаў пошуку. Вы не будзеце мець поўнай абароны метададзеных пры адпраўцы GIF-файлаў."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да предоставя свои предложения на вашите търсения за gif анимации Session е нужно да се свързва с услугата \"Giphy\" Така, когато изпращате GIF анимации няма да се позлвате с пълна защита от изтичане на метаданни."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session Giphy এ সংযোগ করবে অনুসন্ধানের ফলাফল সরবরাহ করার জন্য। আপনাকে গিফ পাঠানোর সময় পুরো মেটাডেটা প্রোটেকশন পাবেন না।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session es connectarà a Giphy per proporcionar resultats de cerca. No tindreu protecció completa de metadades quan envieu GIFs."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session se připojí k Giphy, aby poskytla výsledky vyhledávání. Při odesílání GIFů nebudete mít plnou ochranu metadat."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bydd Session yn cysylltu â Giphy i ddarparu canlyniadau chwilio. Ni fyddwch yn cael diogelu metadata llawn wrth anfon GIFs."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session vil oprette forbindelse til Giphy for at levere søgeresultater. Du vil ikke have fuld beskyttelse af metadata, når du sender GIF'er."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session wird sich mit Giphy verbinden, um Suchergebnisse zu liefern. Beim Senden von GIFs wirst du nicht den vollständigen Metadatenschutz haben."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Session θα συνδεθεί με το Giphy για να παρέχει αποτελέσματα αναζήτησης. Δε θα έχετε πλήρη προστασία μεταδεδομένων όταν στέλνετε GIFs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session will connect to Giphy to provide search results. You will not have full metadata protection when sending GIFs."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session konektos al Giphy por provizi serĉrezultojn. Vi ne havos plenan metadan protekton kiam sendante GIF-ojn."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session se conectará a Giphy para proporcionar los resultados de búsqueda. No tendrás protección completa de metadatos al enviar GIFs."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session se conectará a Giphy para proporcionar resultados de búsqueda. No tendrás protección completa de metadatos al enviar GIFs."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session loob ühenduse Giphyga, et pakkuda otsingutulemusi. GIF-ide saatmisel ei ole teil täielikku metaandmete kaitset."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session Giphy rastrea emateko konektatuko da. Ez duzu metadatuen babesa osoa izango GIFak bidaltzean."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session برای ارائه نتایج جستجو به Giphy متصل می‌شود. هنگام ارسال GIFها، شما محافظت کامل از متاداده نخواهید داشت."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session yhdistää Giphyyn tarjotakseen hakutulokset. GIF-lähetysten yhteydessä et saa täydellistä metatietosuojaa."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ang Session ay kokonekta sa Giphy upang magbigay ng mga resulta ng paghahanap. Hindi ka magkakaroon ng lubos na metadata protection kapag nagpapadala ng mga GIFs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session se connectera à Giphy pour fournir des résultats de recherche. Vous n'aurez pas de protection complète des métadonnées lors de l'envoi de GIFs."
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session conectarase a Giphy para proporcionar resultados de busca. Non terás protección completa de metadata ao enviar GIFs."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session zai haɗa da Giphy don samar da sakamakon bincike. Ba za ku sami cikakken kariyar metadatan ba lokacin aika GIFs."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session יתחבר אל Giphy כדי לספק תוצאות חיפוש. לא תהיה לך הגנה מלאה על נתוני מטא בעת שליחת GIFs."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session खोज परिणाम प्रदान करने के लिए Giphy से कनेक्ट होगा। GIFs भेजते समय आपको पूर्ण मेटाडेटा सुरक्षा नहीं होगी।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session će se povezati s Giphy kako bi pružio rezultate pretraživanja. Nećete imati potpunu zaštitu metapodataka pri slanju GIF-ova."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) Session alkalmazás csatlakozik a Giphy-hez, hogy keresési eredményeket biztosítson. GIF-ek küldésekor nem lesz teljes körű metaadat-védelem."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session-ը կմիակցվի Giphy-ին՝ արդյունքներ որոնելու համար: GIF-ներ ուղարկելիս դուք չեն ունենա ամբողջական մեթադատա պաշտպանություն։"
          }
        },
        "id" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session akan terhubung ke Giphy untuk memberikan hasil pencarian. Anda tidak akan mendapatkan perlindungan metadata penuh saat mengirim GIF."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session si connetterà a Giphy per fornire i risultati della ricerca. Non avrai la protezione completa dei metadati quando invii le GIF."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SessionはGiphyに接続して検索結果を提供します。GIFを送信するときに完全なメタデータ保護はありません。"
          }
        },
        "ka" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ჩაერთვება Giphy-თან ძიების შედეგების მისაცემად. გიფების გაგზავნით თქვენ არ მიიღებთ სრულ მეტამონაცემთა დაცვას."
          }
        },
        "km" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session នឹងភ្ជាប់ទៅ Giphy ដើម្បីផ្ដល់លទ្ធផលស្វែងរក។ អ្នកនឹងមានការការពារ Metadata ពេញលេញទេ នៅពេលផ្ញើ GIFs។"
          }
        },
        "kn" : {
          "stringUnit" : {
            "state" : "translated",
