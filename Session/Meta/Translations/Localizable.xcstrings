      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنتم متيقنون من عرض <b>ملاحظة لنفسي</b> في قائمة المحادثات؟"
