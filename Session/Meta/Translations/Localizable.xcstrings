    "passwordStrengthIndicatorDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعد تعيين كلمة سر قوية في حماية رسائلكم ومرفقاتكم في حال فقدان جهازك أو سرقته."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Güclü bir parol təyin etmək, cihazınız itsə və ya oğurlansa belə mesajlarınızı və qoşmalarınızı qorumağa kömək edir."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nastavení silného hesla pomáhá chránit vaše zprávy a přílohy v případě ztráty nebo odcizení zařízení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein schwieriges Passwort hilft deine Nachrichten und Anlagen zu schützen, wenn dein Gerät jemals verloren geht oder gestohlen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Setting a strong password helps protect your messages and attachments if your device is ever lost or stolen."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer una contraseña fuerte ayuda a proteger tus mensajes y archivos adjuntos si tu dispositivo se pierde o te lo roban."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Establecer una contraseña fuerte ayuda a proteger tus mensajes y archivos adjuntos si tu dispositivo se pierde o te lo roban."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنظیم یک گذرواژهٔ قوی کمک می‌کند در صورت دزدیده‌شدن یا گم‌شدن دستگاهتان، از پیام‌ها و پیوست‌هایتان محافظت شود."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vahvan salasanan asettaminen auttaa suojaamaan viestisi ja liitteesi, jos laitteesi katoaa tai varastetaan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définir un mot de passe robuste permet de protéger vos messages et pièces jointes en cas de perte ou de vol de votre appareil."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक मजबूत पासवर्ड सेट करना आपके संदेशों और संलग्नकों को सुरक्षित रखने में मदद करता है अगर आपका डिवाइस कभी खो जाए या चोरी हो जाए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egy erős jelszó beállítása segít megvédeni üzeneteidet és mellékleteidet, ha az eszközöd elveszik vagy ellopják."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostare una password forte aiuta a proteggere i tuoi messaggi e allegati in caso di smarrimento o furto del dispositivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強力なパスワードを設定することで、デバイスが紛失または盗難にあってもメッセージや添付ファイルを保護できます。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ခိုင်မာသော စကားဝှက်တစ်ခု သတ်မှတ်ခြင်းသည် သင့်စက်ပစ္စည်း ပျောက်ဆုံးသွားခြင်း သို့မဟုတ် အခိုးခံရခြင်း ဖြစ်လာပါက သင့်မက်ဆေ့ချ်များနှင့် ပူးတွဲဖိုင်များကို ကာကွယ်ပေးရန် အထောက်အကူပြုသည်။"
          }
        },
