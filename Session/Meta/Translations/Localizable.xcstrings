    "onionRoutingPathDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session versteek jou IP deur jou boodskappe deur verskeie Service Nodes in Session se gedesentraliseerde netwerk te stuur. Dit is jou huidige pad:"
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session يخفي عنوان IP الخاص بكم عن طريق تمرير رسائلكم عبر عدة نقاط خدمة في شبكة Session اللامركزية. هذا هو المسار الحالي الخاص بك:"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session, mesajlarınızı Session tətbiqinin mərkəzləşdirilməmiş şəbəkəsindəki çoxsaylı xidmət düyünləri üzərindən yönləndirərək IP-nizi gizlədir. Bu, hazırkı yolunuzdur:"
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sessionدی آی پیءَ نے چھپچی کن گهنت روچیءَ دزے پیغامءَ هُن ڪمیں گهنت راهَد سرویس نوڊانی کررہ ، چہ Session'دی ڊیسینټریْلائزڈ نیٹ ورکءِ م، یہ اپءَ حالاتی راه دپتءَ."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session хавае ваш IP, накіроўваючы вашы паведамленні праз некалькі сэрвісных вузлоў у дэцэнтралізаванай сетцы Session. Вось ваш цяперашні шлях:"
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session скрива вашия IP, като пренасочва съобщенията ви през множество Service Node възли в децентрализирана мрежа на Session. Това е текущият ви път:"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session আপনার আইপি ঠিকানা গোপন করে সার্ভিস নোডগুলোর মাধ্যমে আপনার বার্তাগুলিকে ছড়িয়ে দেয় Session এর বিকেন্দ্রীভূত নেটওয়ার্কে। এটি আপনার বর্তমান পথ:"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session amaga la vostra IP redirigint els vostres missatges a través de múltiples Service Nodes a la xarxa descentralitzada de Session. Aquest és el vostre camí actual:"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session skrývá vaši IP adresu tím, že směruje vaše zprávy přes několik serverů služby v decentralizované síti Session. Toto je vaše aktuální trasa:"
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae Session yn cuddio'ch cyfeiriad IP trwy lwybro'ch negeseuon trwy nifer o nodau gwasanaeth yn rhwydwaith gwasgaredig Session. Dyma'ch llwybr presennol:"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session skjuler din IP ved at sende dine beskeder igennem adskillige Service Noder i Session's decentraliserede netværk. Dette er din nuværende rute:"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session verbirgt deine IP-Adresse, indem deine Nachrichten über mehrere Service Nodes im dezentralen Session-Netzwerk geroutet werden. Dies ist dein aktueller Pfad:"
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Session αποκρύπτει την IP σας δρομολογώντας τα μηνύματά σας μέσω πολλών Service Nodes στο αποκεντρωμένο δίκτυο του Session. Αυτή είναι η τρέχουσα διαδρομή σας:"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session hides your IP by routing your messages through multiple service nodes in Session's decentralized network. This is your current path:"
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session kaŝas vian IP per direktigo de viaj mesaĝoj tra pluraj Service Nodes en Session's decentralizita reto. Jen via aktuala vojo:"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session oculta tu dirección IP al enrutar tus mensajes a través de varios nodos de servicio en la red descentralizada de Session. Esta es tu ruta actual:"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session oculta tu IP haciendo rebotar tus mensajes a través de los Service Nodes en la red descentralizada de Session. Esta es tu ruta actual:"
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session peidab teie IP-aadressi, suunates teie sõnumeid läbi mitme teenusesõlme Session'i detsentraliseeritud võrgus. See on teie praegune rada:"
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session(e)k zure IPa ezkutatzen du zure mezuak hainbat Service Node zerbitzari bidez bideratuz Session'ren decentralized network sarean. Hau da zure oraingo bide-lerroa:"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session نشانی اینترنتی یا IP شما را با فرستادن پیام‌های شما از طریق چندین گره در شبکه غیرمتمرکز Session مخفی می‌کند. این مسیر فعلی شما است:"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session piilottaa IP-osoitteesi ohjaamalla viestisi useiden Service Node määritteiden kautta Session hajautetussa verkossa. Tämä on nykyinen reittisi:"
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Itinatago ng Session ang iyong IP sa pamamagitan ng pagruruta ng iyong mga mensahe sa maraming service nodes sa decentralized network ng Session. Ito ang iyong kasalukuyang daan:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session cache votre adresse IP en envoyant vos messages via plusieurs nœuds de service dans le réseau décentralisé de Session. Voici votre chemin actuel :"
          }
        },
        "gl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session agocha o teu IP ao redirixir as túas mensaxes a través de múltiples Service Node na rede descentralizada de Session. Este é o teu camiño actual:"
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ya ɓoye IP ɗinka ta hanyar turawa saƙonninka ta hanyar ɗakunan sabis da yawa a cikin cibiyar sadarwar tsarin rarrabawa na Session. Wannan shine hanyar ka ta yanzu:"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session מסתיר את כתובת ה-IP שלך על ידי ניתוב ההודעות שלך דרך מספר צומתי שירות ברשת המבוזרת של Session. זהו המסלול הנוכחי שלך:"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session आपके संदेशों को Session के डेंटरलिज़्ड नेटवर्क के कई Service Nodes के माध्यम से रूट करके आपकी IP को छुपाता है। यह आपका वर्तमान पथ है:"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session skriva vaš IP usmjeravanjem vaših poruka kroz više uslužnih čvorova u Session decentraliziranoj mreži. Ovo je vaša trenutna putanja:"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) Session elrejti az IP-címét azáltal, hogy üzeneteit a(z) Session decentralizált hálózatának több kiszolgálócsomópontján keresztül irányítja. Ez az Ön jelenlegi útvonala:"
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
