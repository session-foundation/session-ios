    "inviteNewMemberGroupLink" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ادعوا عضوًا جديدًا إلى المجموعة عن طريق إدخال معرف حساب صديقكم أو ONS أو مسح رمزه QR {icon}"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dostunuzun Hesab kimliyini, ONS-sini daxil edərək və ya onun QR kodunu skan edərək qrupa yeni üzv dəvət edin {icon}"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozvěte nového člena do skupiny zadáním ID účtu vašeho přítele, ONS nebo naskenováním jejich QR kódu {icon}"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lade ein neues Mitglied in die Gruppe ein, indem du die Account-ID oder ONS deines Freundes eingibst oder seinen QR-Code scannst {icon}"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invite a new member to the group by entering your friend's Account ID, ONS or scanning their QR code {icon}"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a un nuevo miembro al grupo ingresando el ID de cuenta, ONS o escaneando su código QR {icon}"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita a un nuevo miembro al grupo ingresando el ID de cuenta, ONS o escaneando su código QR {icon}"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "با واردکردن شناسهٔ حساب کاربری یا ONS دوست خود یا اسکن‌کردن کد QR آن‌ها {icon}، عضو جدیدی را به گروه دعوت کنید"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kutsu uusi jäsen ryhmään syöttämällä ystäväsi tilitunnus (Account ID) tai ONS-tunnus tai skannaamalla heidän QR-koodinsa {icon}"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invitez un nouveau membre au groupe en entrant l'ID de compte, l'ONS ou en scannant le code QR {icon} de ce membre"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अपने मित्र की खाता आईडी, ONS दर्ज करके या उनके QR कोड को स्कैन करके समूह में एक नया सदस्य आमंत्रित करें {icon}"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hívj meg egy új tagot a csoportba a barátod Felhasználóazonosítójának (Account ID), ONS azonosítójának megadásával, vagy a QR-kód beolvasásával {icon}"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Invita un nuovo membro al gruppo inserendo l'ID utente, l'ONS del tuo amico o scansionando il loro codice QR {icon}"
