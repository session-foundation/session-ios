        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous ne pouvez pas revenir en arrière. Pour annuler la création de votre compte, Session doit quitter."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ba za ku iya komawa baya ba. Domin dakatar da ƙirƙirar asusunka, Session yana buƙatar rufe."
