    "donateSessionDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحاول قوى نافذة إضعاف الخصوصية، لكن لا يمكننا مواصلة هذه المعركة وحدنا.<br/><br/>يساعد التبرع في الحفاظ على Session آمنًا ومستقلًا ومتاحًا على الإنترنت."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mocné síly se snaží oslabit soukromí, ale tento boj nemůžeme vést sami.<br/><br/>Příspěvky pomáhají udržet aplikaci Session bezpečnou, nezávislou a online."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mächtige Kräfte versuchen, die Privatsphäre zu schwächen – aber wir können diesen Kampf nicht alleine führen.<br/><br/>Mit einer Spende hilfst du dabei, Session sicher, unabhängig und online zu halten."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ισχυρές δυνάμεις προσπαθούν να αποδυναμώσουν την ιδιωτϻικότητα, αλλά δεν μπορούμε να συνεχίσουμε αυτόν τον αγώνα μόνοι μας.<br/><br/>Η δωρεά βοηθά να παραμείνει το Session ασφαλές, ανεξάρτητο και διαθέσιμο στο διαδίκτυο."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Powerful forces are trying to weaken privacy, but we can’t continue this fight alone.<br/><br/>Donating helps keep Session secure, independent, and online."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuerzas poderosas intentan debilitar la privacidad, pero no podemos continuar esta lucha solos.<br/><br/>Donar ayuda a mantener Session seguro, independiente y en línea."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fuerzas poderosas intentan debilitar la privacidad, pero no podemos continuar esta lucha solos.<br/><br/>Donar ayuda a mantener Session seguro, independiente y en línea."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نیروهای قدرتمندی در تلاش‌اند تا حریم خصوصی را تضعیف کنند، اما ما نمی‌توانیم این مبارزه را به‌تنهایی ادامه دهیم.<br/><br/>کمک مالی شما به امن، مستقل و در دسترس ماندن Session کمک می‌کند."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voimakkaat tahot yrittävät heikentää yksityisyytt, mutta emme voi jatkaa tätä taistelua yksin.<br/><br/>Lahjoittaminen auttaa pitämään Session-sovelluksen turvallisena, riippumattomana ja verkossa."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des forces importantes cherchent à affaiblir la vie privée, mais nous ne pouvons poursuivre ce combat seuls.<br/><br/>Faire un don permet à Session de rester sécurisé, indépendant et accessible."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "शक्तिशाली ताकतें गोपनीयता को कमजोर करने का प्रयास कर रही हैं, लेकिन हम यह लड़ाई अकेले नहीं जारी रख सकते।<br/><br/>दान करने से Session को सुरक्षित, स्वतंत्र और ऑनलाइन बनाए रखने में मदद मिलती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hatalmas erők próbálják gyengíteni az adatvédelmet, de ezt a harcot nem tudjuk egyedül folytatni.<br/><br/>A támogatásod segít megőrizni a(z) Session biztonságát, függetlenségét és elérhetőségét."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forze potenti stanno cercando di indebolire la privacy, ma non possiamo continuare questa battaglia da soli.<br/><br/>Donare aiuta a mantenere Session sicuro, indipendente e online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "強大な勢力がプライバシーの弱体化を試みていますが、私たちだけではこの戦いを続けられません。<br/><br/>寄付により、Sessionの安全性、独立性、そしてオンライン維持を支援できます。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ကိုယ်ရေးလုံခြုံမှုကို အားနည်းစေရန် အင်အားကြီး အဖွဲ့အစည်းများက ကြိုးပမ်းနေကြသော်လည်း ကျွန်ုပ်တို့သည် ဤတိုက်ပွဲကို တစ်ယောက်တည်း ဆက်လက် မတိုက်ခိုက်နိုင်ပါ။<br/><br/>လှူဒါန်းခြင်းဖြင့် Session ကို လုံခြုံစိတ်ချရမှုရှိစေပြီး လွတ်လပ်စွာ ရပ်တည်နိုင်စေကာ အွန်လိုင်းတွင် ဆက်လက် ရှိနေစေရန် ကူညီပေးပါသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mektige krefter prøver å svekke personvernet, men vi kan ikke kjempe denne kampen alene.<br/><br/>Donasjoner bidrar til å holde Session sikkert, uavhengig og tilgjengelig."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mektige krefter prøver å svekke personvernet, men vi kan ikke kjempe denne kampen alene.<br/><br/>Donasjoner bidrar til å holde Session sikkert, uavhengig og tilgjengelig."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Krachtige machten proberen privacy te ondermijnen, maar we kunnen deze strijd niet alleen voeren.<br/><br/>Donaties helpen om Session veilig, onafhankelijk en online te houden."
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mektige krefter prøver å svekke personvernet, men vi kan ikke kjempe denne kampen alene.<br/><br/>Donasjoner bidrar til å holde Session sikkert, uavhengig og tilgjengelig."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Potężne siły próbują osłabić prywatność, ale nie możemy prowadzić tej walki sami.<br/><br/>Twoja darowizna pomoże utrzymać Session jako bezpieczną, niezależną i działającą aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forças poderosas estão tentando enfraquecer a privacidade, mas não podemos continuar essa luta sozinhos.<br/><br/>Doar ajuda a manter o Session seguro, independente e online."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forças poderosas estão tentando enfraquecer a privacidade, mas não podemos continuar esta luta sozinhos.<br/><br/>Doar ajuda a manter o Session seguro, independente e online."
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forțe puternice încearcă să slăbească confidențialitatea, dar nu putem duce această luptă singuri.<br/><br/>Donațiile ajută la menținerea Session sigur, independent și online."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Серьёзные силы пытаются подорвать приватность, и мы не можем продолжать борьбу в одиночку.<br/><br/>Ваши пожертвования помогают нам обеспечивать безопасность, независимость и доступность Session."
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Starka krafter försöker försvaga den personliga integriteten, men vi kan inte fortsätta kampen ensamma.<br/><br/>Att donera hjälper till att hålla Session säker, oberoende och online."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gizliliği zayıflatmaya çalışan güçlü güçler var, ancak bu mücadeleyi tek başımıza sürdüremeyiz.<br/><br/>Bağış yapmak Session uygulamasının güvenli, bağımsız ve çevrim içi kalmasına yardımcı olur."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Потужні сили намагаються послабити конфіденційність, але ми не можемо продовжувати цю боротьбу наодинці.<br/><br/>Ваші пожертви допомагають зберегти Session захищеним, незалежним і доступним онлайн."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有强大的势力正试图削弱隐私保护，但我们无法独自应对这场战斗。<br/><br/>捐赠有助于保持 Session 的安全性、独立性和在线状态。"
          }
        }
      }
    },
