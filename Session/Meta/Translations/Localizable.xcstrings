    "proPlanPlatformRefund" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظرًا لأنكم تسجلتم في الأصل في Session Pro عبر <b><span>{platform_store}</span></b>، ستحتاجون إلى استخدام حساب {platform_account} لطلب استرداد المبلغ."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başda <b><span>{platform_store} Mağazası</span></b> üzərindən Session Pro üçün qeydiyyatdan keçdiyinizə görə, geri ödəmə tələbini göndərmək üçün eyni {platform_account} hesabını istifadə etməlisiniz."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Protože jste se původně zaregistrovali do Session Pro přes <b><span>obchod {platform_store}</span></b>, budete muset pro žádost o vrácení peněz použít stejný účet {platform_account}."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da Sie sich ursprünglich über den <b><span>{platform_store}</span></b> für Session Pro registriert haben, müssen Sie Ihr {platform_account} verwenden, um eine Rückerstattung zu beantragen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Because you originally signed up for Session Pro via the <b><span>{platform_store}</span></b>, you'll need to use your {platform_account} to request a refund."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como te registraste originalmente en Session Pro a través de la <b><span>{platform_store}</span></b>, deberás usar tu cuenta {platform_account} para solicitar un reembolso."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Como te registraste originalmente en Session Pro a través de la <b><span>{platform_store}</span></b>, deberás usar tu cuenta {platform_account} para solicitar un reembolso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ازآنجاکه شما از ابتدا برای Session Pro از طریق <b><span>{platform_store}</span></b> ثبت‌نام کردید، برای درخواست استرداد وجه باید از {platform_account} خود استفاده کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koska rekisteröidyit alun perin palveluun Session Pro <b><span>{platform_store}</span></b>-palvelun kautta, sinun tulee käyttää {platform_account}-tiliäsi pyytääksesi hyvitystä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parce que vous avez initialement souscrit Session Pro depuis <b><span>{platform_store}</span></b>, vous devrez utiliser le même {platform_account} pour demander un remboursement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "चूंकि आपने मूल रूप से <b><span>{platform_store}</span></b> के माध्यम से Session Pro के लिए साइन अप किया था, इसलिए आपको धनवापसी का अनुरोध करने के लिए अपने {platform_account} का उपयोग करना होगा।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mivel eredetileg a <b><span>{platform_store}</span></b> áruházon keresztül iratkoztál fel a Session Pro-ra, ugyanazt a {platform_account} fiókot kell használnod a visszatérítés kéréséhez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Poiché ti sei registrato inizialmente a Session Pro tramite il <b><span>{platform_store}</span></b>, dovrai usare il tuo {platform_account} per richiedere un rimborso."
          }
        },
        "ja" : {
          "stringUnit" : {
