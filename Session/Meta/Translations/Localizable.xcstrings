    "proAccessNotFoundDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتشف Session أن حسابك لا يحتوي على صلاحية وصول Pro. إذا كنتم تعتقدون أن هذا خطأ، يُرجى التواصل مع دعم Session للحصول على المساعدة."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session, hesabınızda Pro erişimi olmadığını müəyyən etdi. Bunun bir səhv olduğunu düşünürsünüzsə, lütfən kömək üçün Session dəstəyi ilə əlaqə saxlayın."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace Session zjistila, že váš účet nemá přístup k Pro. Pokud si myslíte, že se jedná o chybu, kontaktujte podporu Session a požádejte o pomoc."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session hat festgestellt, dass dein Konto keinen Pro-Zugang besitzt. Wenn du glaubst, dass es sich um einen Fehler handelt, kontaktiere bitte den Session-Support."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session detected that your account does not have Pro access. If you believe this is a mistake, please reach out to Session support for assistance."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session detectó que tu cuenta no tiene acceso Pro. Si crees que se trata de un error, contacta al soporte de Session para obtener ayuda."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session detectó que tu cuenta no tiene acceso Pro. Si crees que se trata de un error, contacta al soporte de Session para obtener ayuda."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session تشخیص داد که حساب شما دسترسی Pro ندارد. اگر فکر می‌کنید این یک اشتباه است، لطفاً برای دریافت کمک با پشتیبانی Session تماس بگیرید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session havaitsi, että tililläsi ei ole Pro-oikeuksia. Jos uskot tämän olevan virhe, ota yhteyttä Session-tukeen saadaksesi apua."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session a détecté que votre compte ne dispose pas d’un accès Pro. Si vous pensez qu’il s’agit d’une erreur, veuillez contacter l’assistance de Session pour obtenir de l’aide."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ने पाया कि आपके खाते में Pro एक्सेस नहीं है। यदि आपको लगता है कि यह एक त्रुटि है, तो कृपया सहायता के लिए Session समर्थन से संपर्क करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) Session észlelte, hogy fiókja nem rendelkezik Pro hozzáféréssel. Ha úgy gondolja, hogy ez tévedés, kérjük, forduljon a(z) Session ügyfélszolgálatához segítségért."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ha rilevato che il tuo account non dispone dell'accesso Pro. Se pensi si tratti di un errore, contatta l'assistenza di Session per ricevere aiuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session は、お客様のアカウントに Pro アクセスがないことを検出しました。これが誤りだと思われる場合は、サポートが必要ですので、Session サポートへご連絡ください。"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session သည် သင့်အကောင့်တွင် Pro အသုံးပြုခွင့် မရှိကြောင်း တွေ့ရှိခဲ့သည်။ ၎င်းမှာ အမှားတစ်ခုဟု သင်ယုံကြည်ပါက အကူအညီရယူရန် Session ပံ့ပိုးကူညီမှုအဖွဲ့သို့ ဆက်သွယ်ပါ။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session oppdaget at kontoen din ikke har Pro-tilgang. Hvis du mener dette er en feil, vennligst kontakt brukerstøtte hos Session for hjelp."
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session oppdaget at kontoen din ikke har Pro-tilgang. Hvis du mener dette er en feil, vennligst kontakt brukerstøtte hos Session for hjelp."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session heeft vastgesteld dat je account geen Pro-toegang heeft. Als je denkt dat dit een vergissing is, neem dan contact op met de ondersteuning van Session voor hulp."
