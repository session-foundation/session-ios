        },
        "pa-IN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "<b>ਤੁਸੀਂ</b>ਨਾ ਗੈਰ ਸੁਨੇਹੇ ਸੁਨੇਹੇ ਸੈਟਿੰਗ ਦਾ ਨਵੀਨੀਕਰਨ ਕੀਤਾ ਹੈ।"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
