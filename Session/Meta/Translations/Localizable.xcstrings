    "proRefundDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نأسف لمغادرتكم. إليكم ما تحتاجون إلى معرفته قبل طلب استرداد المبلغ."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Getməyinizə məyus olduq. Geri ödəmə tələb etməzdən əvvəl bilməli olduğunuz şeylər."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mrzí nás, že to rušíte. Než požádáte o vrácení peněz, přečtěte si informace, které byste měli vědět."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es ist schade, dass du gehst. Das solltest du wissen, bevor du eine Rückerstattung beantragst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We’re sorry to see you go. Here's what you need to know before requesting a refund."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lamentamos que te vayas. Esto es lo que necesitas saber antes de solicitar un reembolso."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lamentamos que te vayas. Esto es lo que necesitas saber antes de solicitar un reembolso."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متأسفیم که می‌خواهید بروید. پیش از درخواست استرداد وجه، این موارد را باید بدانید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ikävää, että olet lähdössä. Tässä on, mitä sinun tulee tietää ennen hyvityspyynnön tekemistä."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes désolés de vous voir partir. Voici ce que vous devez savoir avant de demander un remboursement."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें आपके जाने का दुख है। रिफंड का अनुरोध करने से पहले आपको ये बात जाननी चाहिए।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sajnáljuk, hogy elmegy. Íme, amit tudnia kell, mielőtt visszatérítést kér."
          }
        },
        "it" : {
          "stringUnit" : {
