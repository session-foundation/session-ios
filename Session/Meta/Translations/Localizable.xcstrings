    "linkPreviewsTurnedOffDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session moet gekoppelde webwerwe kontak om voorskoue van skakels wat jy stuur en ontvang te genereer.<br/><br/>Jy kan hulle aanskakel in Session se instellings."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجب على Session الاتصال بالمواقع المرتبطة لإنشاء معاينات للروابط التي ترسلون وتستقبلون.<br/><br/> يمكنك تفعيلها في إعدادات Session."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session göndərdiyiniz və aldığınız keçidlərin önizləmələrini yaratmaq üçün əlaqələndirilmiş veb saytlarla əlaqə saxlamalıdır.<br/><br/>Onları Session ayarlarında işə sala bilərsiniz."
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session پیڈلنکلاسٹ بندشین وِسا پنیں لرناں سکال کیئے.<br/><br/>چاہ گرتیے دستندہ تشکیل کریں Sessionیبچ تحتدی"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session павінен звяртацца да звязаных вэб-сайтаў, каб атрымліваць прэв'ю спасылак, якія вы адпраўляеце і атрымліваеце.<br/><br/>Вы можаце ўключыць гэта ў наладках Session."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "За да бъде възможно генериране на графично представяне за интернет страниците, към които изпращате препратки (линкове) или за които получавате такива, Session се нуждае от разрешение да се свързва с въпросните страници.<br/><br/>Можете да включите тази услуга в настройките на Session."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session সংযুক্ত ওয়েবসাইটগুলি প্রি-ভিউস তৈরির জন্য যোগাযোগ করতে হবে।<br/><br/>আপনি এগুলি Session এর সেটিংসে চালু করতে পারেন।"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ha de contactar amb llocs web enllaçats per generar previsualitzacions dels enllaços que envieu i rebeu.<br/><br/>Podeu activar-ho a la configuració de Session."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session musí kontaktovat propojené webové stránky, aby vytvořil náhledy odkazů, které posíláte a přijímáte.<br/><br/>Můžete je zapnout v nastavení Session."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mae'n rhaid i Session gysylltu â gwefannau cysylltiedig i gynhyrchu rhagolwg o ddolenni a anfonwch a derbyniwch.<br/><br/>Gallwch eu troi ymlaen yng ngosodiadau Session."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session skal kontakte tilknyttede websites for at generere forhåndsvisninger af links, du sender og modtager.<br/><br/>Du kan slå dem til i Session's indstillinger."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session muss verlinkte Webseiten kontaktieren, um Vorschauen von Links zu erstellen, die du sendest und empfängst.<br/><br/>Du kannst diese Funktion in den Session-Einstellungen aktivieren."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Session πρέπει να επικοινωνήσει με συνδεδεμένες ιστοσελίδες για να δημιουργήσει προεπισκοπήσεις των συνδέσμων που στέλνετε και λαμβάνετε.<br/><br/>Μπορείτε να τις ενεργοποιήσετε στις ρυθμίσεις του Session."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session must contact linked websites to generate previews of links you send and receive.<br/><br/>You can turn them on in Session's settings."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session devas kontakti ligitajn retejojn por generi antaŭprezentojn de ligiloj kiujn vi sendas kaj ricevas.<br/><br/>Vi povas ŝalti ilin en la agordoj de Session."
          }
        },
        "es-419" : {
