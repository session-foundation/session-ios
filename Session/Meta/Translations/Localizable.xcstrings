        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Դուք չեք կարող հետ գնալ։ Ձեր հաշվի ստեղծումը չեղարկելու համար Session-ը պետք է ավարտել։"
