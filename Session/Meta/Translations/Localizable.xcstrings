    "proAccessActivatedAutoShort" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وصولكم إلى Pro نشط!<br/><br/>سيُجدد وصولكم إلى Pro تلقائيًا لمدة <b>{current_plan_length}</b> في <b>{date}</b>."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro erişiminiz aktivdir!<br/><br/>Pro erişiminiz avtomatik olaraq başqa <b>{current_plan_length}</b> üçün <b>{date}</b> tarixində yenilənəcək."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Váš přístup k Pro je aktivní!<br/><br/>Přístup k Pro bude automaticky prodloužen na další <b>{current_plan_length}</b> dne <b>{date}</b>."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Pro-Zugang ist aktiv!<br/><br/>Dein Pro-Zugang wird am <b>{date}</b> automatisch für weitere <b>{current_plan_length}</b> verlängert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Pro access is active!<br/><br/>Your Pro access will automatically renew for another <b>{current_plan_length}</b> on <b>{date}</b>."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Tu acceso a Pro está activo!<br/><br/>Tu acceso a Pro se renovará automáticamente por otro <b>{current_plan_length}</b> el <b>{date}</b>."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Tu acceso a Pro está activo!<br/><br/>Tu acceso a Pro se renovará automáticamente por otro <b>{current_plan_length}</b> el <b>{date}</b>."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دسترسی Pro شما فعال است!<br/><br/>دسترسی Pro شما به‌صورت خودکار برای <b>{current_plan_length}</b> دیگر در <b>{date}</b> تمدید خواهد شد."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pro-oikeutesi on aktiivinen!<br/><br/>Pro-oikeutesi uusiutuu automaattisesti toiseksi <b>{current_plan_length}</b> <b>{date}</b>."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre accès Pro est actif ! <br/><br/>Votre accès Pro sera automatiquement renouvelé pour une période de <b>{current_plan_length}</b> le <b>{date}</b>."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपकी Pro पहुँच सक्रिय है!<br/><br/>आपकी Pro पहुँच <b>{current_plan_length}</b> के लिए <b>{date}</b> को स्वचालित रूप से नवीनीकृत हो जाएगी।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A(z) Pro hozzáférése aktív!<br/><br/>A(z) Pro hozzáférése automatikusan megújul még <b>{current_plan_length}</b> időtartamra <b>{date}</b> dátummal."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il tuo accesso Pro è attivo!<br/><br/>Il tuo accesso Pro si rinnoverà automaticamente per un altro <b>{current_plan_length}</b> il <b>{date}</b>."
          }
        },
        "ja" : {
