    "permissionMusicAudioDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session benodig musiek en oudio toegang om lêers, musiek en oudio te stuur, maar dit is permanent geweier. Tik Instellings → Toestemmings, en skakel \"Musiek en oudio\" aan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Session إذن الوصول إلى الموسيقى والصوت من أجل إرسال الملفات والموسيقى والصوت، ولكن تم رفضه نهائيًا. يجب النقر على الإعدادات ثم الأذونات، وتفعيل \"الموسيقى والصوت\"."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fayl, musiqi və səs göndərə bilməyiniz üçün Session musiqi və səslərə erişməlidir, ancaq bu erişimə birdəfəlik rədd cavabı verilib. Ayarlar → \"İcazələr\"ə toxunun və \"Musiqi və səs\"i işə salın."
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session کی موسیقی اور آڈیو تک رسائی ضروری ہے تاکہ آپ فائلیں، موسیقی اور آڈیو بھیج سکیں، لیکن اسے مستقل طور پر ممنوع کر دیا گیا ہے۔ سیٹنگز ٹیپ کریں → اجازتیں، اور \"موسیقی اور آڈیو\" کو آن کریں۔"
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session патрабуе доступу да музыкі і аўдыё для адпраўкі файлаў, музыкі і аўдыё, але доступ быў пастаянна забаронены. Націсніце «Налады» → «Дазволы» і актывуйце «Музыка і аўдыё»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session се нуждае от достъп до музика и аудио, за да може да изпращате файлове, музика и аудио, но достъпът е бил отказан постоянен. Отидете в Настройки → Разрешения и включете \"Музика и аудио\"."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session এর ফাইল, সঙ্গীত এবং অডিও পাঠানোর জন্য সঙ্গীত ও অডিও অ্যাক্সেস প্রয়োজন, কিন্তু এটি স্থায়ীভাবে প্রত্যাখ্যান করা হয়েছে। Tap Settings → Permissions, and turn \"Music and audio\" on."
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session necessita accés a la música i l'àudio per enviar fitxers, música i àudio, però s'ha denegat permanentment. Toqueu Configuració → Permisos, i activeu \"Música i àudio\"."
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session potřebuje přístup k hudbě a zvuku, aby mohla posílat soubory, hudbu a zvuk. Přístup byl ale trvale odepřen. Klepněte na Nastavení → Oprávnění a zapněte \"Hudba a zvuk\"."
          }
        },
        "cy" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session angen mynediad at gerddoriaeth ac sain er mwyn anfon ffeiliau, cerddoriaeth a sain, ond mae wedi'i wrthod yn barhaol. Tapiwch Gosodiadau → Trwyddedau, a throi \"Cerddoriaeth a sain\" ymlaen."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session kræver musik- og lydadgang for at sende filer, musik og lyd, men det er blevet permanent nægtet. Tryk på Indstillinger → Tilladelser, og slå \"Musik og lyd\" til."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session benötigt Musik- und Audiozugriff, um Dateien, Musik und Audio zu senden, aber der Zugriff wurde dauerhaft verweigert. Bitte öffne die Einstellungen, wähle »Berechtigungen« und aktiviere »Musik und Audio«."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session χρειάζεται πρόσβαση στη μουσική και τον ήχο για να στείλει αρχεία, μουσική και ήχο, αλλά η πρόσβαση έχει απορριφθεί μόνιμα. Πατήστε Ρυθμίσεις → Δικαιώματα, και ενεργοποιήστε το \"Μουσική και ήχος\"."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session needs music and audio access in order to send files, music and audio, but it has been permanently denied. Tap Settings → Permissions, and turn \"Music and audio\" on."
          }
        },
        "eo" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session needs music and audio access in order to send files, music and audio, but it has been permanently denied. Tap Settings → Permissions, and turn \"Music and audio\" on."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session necesita acceso a música y audio para enviar archivos, música y audio, pero ha sido denegado permanentemente. Toca Configuración → Permisos, y activa \"Música y audio\"."
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session necesita acceso a música y audio para enviar archivos, música y audio, pero ha sido denegado permanentemente. Toca Configuración → Permisos, y activa \"Música y audio\"."
          }
        },
        "et" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session vajab muusika ja audio juurdepääsu failide, muusika ja audio saatmiseks, kuid see on jäädavalt keelatud. Puudutage Seaded → Load, ja lülitage \"Muusika ja audio\" sisse."
          }
        },
        "eu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session(e)k musika eta audio sarbidea behar du fitxategiak, musika eta audioak bidaltzeko, baina behin betiko ukatu da. Ezarpenak ukitu → Baimenak, eta aktibatu \"Musika eta audioak\"."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session برای فرستادن فایل، آهنگ و صوت نیاز به دسترسی به آهنگ و صدا دارد، اما این دسترسی به طور دائم رد شده است. به تنظیمات → مجوز‌ها رفته و «صدا و آهنگ» را فعال کنید."
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session tarvitsee pääsyn musiikkiin ja ääniin, jotta se voi lähettää tiedostoja, musiikkia ja ääntä, mutta pääsy on pysyvästi estetty. Napauta Asetukset → Luvat ja salli \"Musiikki ja äänet\"."
          }
        },
        "fil" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session needs music and audio access in order to send files, music and audio, but it has been permanently denied. Tap Settings → Permissions, and turn \"Music and audio\" on."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session a besoin d'un accès à la musique et à l'audio pour envoyer des fichiers, de la musique et de l'audio, mais il a été refusé définitivement. Appuyez sur Paramètres → Autorisations, puis activez \"Musique et audio\"."
          }
        },
        "ha" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session yana buƙatar samun damar amfani da kiɗi da sauti don aika fayiloli, kiɗi da sauti, amma an haramta shi dindindin. Danna Saituna → Izini, kuma kunna \"Kiɗi da sauti\"."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session זקוק לגישה למוזיקה ואודיו על מנת לשלוח קבצים, מוזיקה ואודיו, אבל היא נדחתה לצמיתות. Tap Settings → Permissions, and turn \"Music and audio\" on."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session को संगीत और ऑडियो एक्सेस की आवश्यकता है ताकि फ़ाइलें, संगीत और ऑडियो भेजी जा सकें, लेकिन इसे स्थायी रूप से अस्वीकार कर दिया गया है। सेटिंग्स पर टैप करें → अनुमतियां, और \"संगीत और ऑडियो\" चालू करें।"
          }
        },
        "hr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session treba pristup glazbi i zvuku kako bi mogao slati datoteke, glazbu i zvuk, no to je sada trajno onemogućeno. Tap Settings → Permissions, i uključite \"Glazba i zvuk\"."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session alkalmazásnak zene és hang-hozzáférésre van szüksége a fájlok és zenék küldéséhez, de ez nem lett megadva. Kérlek, lépj tovább az alkalmazás beállításokhoz, válaszd az \"Engedélyek\" lehetőséget, majd engedélyezd a \"Zene és hang\" hozzáférést."
          }
        },
        "hy-AM" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session-ը պահանջում է երաժշտության և աուդիո հասանելիությունը ֆայլեր, երաժշտություն և աուդիո ուղարկելու համար, սակայն թույլտվությունը մշտապես մերժված է: Սեղմեք Կարգավորումներ → Թույլտվություններ և միացրեք \"Երաժշտություն և աուդիո\" կարգավորումը:"
          }
        },
        "id" : {
          "stringUnit" : {
