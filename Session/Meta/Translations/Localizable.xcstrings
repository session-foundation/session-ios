    "rateSessionModalDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسعدنا أنكم تستمتعون بتجربة استخدام Session. إذا كان لديكم بعض الوقت، فإن تقييمكم لنا على {storevariant} يساعد الآخرين على اكتشاف المراسلة الخاصة والآمنة!"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Çox şad olduq ki, Session tətbiqindən həzz alırsınız. Bircə dəqiqəniz varsa, bizi {storevariant} üzərində qiymətləndirin, çünki bu, başqalarının şəxsi və təhlükəsiz mesajlaşmanı kəşf etməsinə kömək edir!"
          }
        },
        "ca" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ens alegrem que gaudiu Session, si teniu un moment, ens classifiqueu a la {storevariant} ajuda els altres a descobrir missatgeria privada i segura!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jsme rádi, že se vám Session líbí. Pokud máte chvíli času, ohodnoťte nás na {storevariant} abyste ostatním pomohli objevit soukromou a bezpečnou komunikaci!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es freut uns, dass du Session genießt! Wenn du einen Moment Zeit hast, hilft eine Bewertung im {storevariant} anderen dabei, private und sichere Nachrichten zu entdecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're glad you're enjoying Session, if you have a moment, rating us in the {storevariant} helps others discover private, secure messaging!"
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We're glad you're enjoying Session, if you have a moment, rating us in the {storevariant} helps others discover private, secure messaging!"
          }
        },
        "es-ES" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nos alegra que estés disfrutando de Session. Si tienes un momento, calificarnos en {storevariant} ayuda a otros a descubrir la mensajería privada y segura."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خوشحالیم که از Session لذت می‌برید. اگر فرصت دارید، امتیازدهی به ما در {storevariant} به دیگران کمک می‌کند یک پیام‌رسان خصوصی و امن پیدا کنند!"
          }
        },
        "fi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hienoa, että pidät sovelluksesta Session. Jos sinulla on hetki aikaa, arvostelumme {storevariant}:ssa auttaa muita löytämään yksityisen ja turvallisen viestinnän!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous sommes ravis que vous appréciiez Session. Si vous avez un instant, une évaluation sur {storevariant} aiderait d'autres personnes à découvrir la messagerie privée et sécurisée !"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "हमें खुशी है कि आपको Session पसंद आ रहा है, यदि आपके पास एक क्षण है, तो {storevariant} पर हमारी रेटिंग देने से दूसरों को निजी, सुरक्षित मैसेजिंग खोजने में मदद मिलती है!"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Örülünk, hogy élvezed a Session használatát! Ha van egy perced, értékelj minket a(z) {storevariant}-on – ezzel másoknak is segítesz felfedezni a privát és biztonságos üzenetváltást!"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Siamo felici che ti stia piacendo Session. Se hai un momento, lascia una valutazione su {storevariant}, aiuterà altri a scoprire la messaggistica privata e sicura!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session をご利用いただきありがとうございます。お時間があれば、{storevariant} で評価していただけると、他の方がプライベートで安全なメッセージを見つける手助けになります！"
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session ကို သင်နှစ်သက်သည့်အတွက် ဝမ်းသာပါသည်။ အချိန်ရှိပါက {storevariant} တွင် ကျွန်ုပ်တို့ကို အဆင့်သတ်မှတ်ပေးခြင်းဖြင့် အခြားသူများလည်း လုံခြုံစိတ်ချရသော စာပို့ဆက်သွယ်မှုအက်ပ်ကို ရှာဖွေတွေ့ရှိနိုင်ပါသည်။"
          }
        },
        "nb" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så bra at du liker Session. Hvis du har litt tid, hjelper en vurdering oss i {storevariant} med å gjøre privat og sikker meldingsutveksling kjent for andre!"
          }
        },
        "nb-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så bra at du liker Session. Hvis du har litt tid, hjelper en vurdering oss i {storevariant} med å gjøre privat og sikker meldingsutveksling kjent for andre!"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fijn dat je Session leuk vindt! Als je een momentje hebt, helpt een beoordeling in de {storevariant} anderen om privé en veilig berichten te ontdekken!"
          }
        },
        "nn-NO" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Så bra at du liker Session. Hvis du har litt tid, hjelper en vurdering oss i {storevariant} med å gjøre privat og sikker meldingsutveksling kjent for andre!"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cieszymy się, że podoba Ci się Session. Jeśli masz chwilę, oceń nas w {storevariant}, aby pomóc innym odkryć prywatne i bezpieczne wiadomości!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficamos felizes que você esteja gostando do Session. Se tiver um momento, avaliá-lo na {storevariant} ajuda outras pessoas a descobrir mensagens privadas e seguras!"
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ficamos felizes por estar a gostar do Session. Se tiver um momento, dar-nos uma avaliação na {storevariant} ajuda outros a descobrir mensagens privadas e seguras!"
          }
        },
        "ro" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bucurăm că îți place Session, dacă ai un minut, o evaluare în {storevariant} îi ajută și pe alții să descopere mesageria privată și sigură!"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Рады, что вам нравится Session. Если у вас есть минутка, оцените нас в {storevariant}. Это поможет другим открыть для себя приватный и безопасный обмен сообщениями!"
          }
        },
        "sv-SE" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vi är glada att du gillar Session, om du har en stund hjälper det andra att upptäcka privat och säker meddelandehantering om du betygsätter oss i {storevariant}!"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session'ı beğenmenize sevindik, bir dakikanız varsa {storevariant}'da bize oy verin. Başkalarının da özel ve güvenli mesajlaşmayı keşfetmesine yardımcı olun."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ми раді, що вам подобається Session. Якщо маєте хвильку, оцініть нас у {storevariant} — це допоможе іншим знайти безпечний та приватний спосіб спілкування!"
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高兴您喜欢 Session，如果方便的话，请在 {storevariant} 上为我们评分，这将帮助他人发现私密、安全的消息方式！"
          }
        },
        "zh-TW" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "很高興您喜歡使用 Session，如果有空，請在 {storevariant} 中給我們評分，幫助更多人找到私密、安全的訊息工具！"
          }
        }
      }
    },
    "rateSessionModalDescriptionUpdated" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعرض Session أي إعلانات، ولا يبيع أي بيانات، ولا يخضع إلا لمستخدميه. يساعد تقييمكم على {storevariant} المزيد من الأشخاص في العثور على تطبيق مراسلة يحترم خصوصيتهم فعلاً."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session schaltet keine Werbung, verkauft keine Nutzerdaten und ist nur seinen Nutzern gegenüber verantwortlich. Ihre Bewertung bei {storevariant} hilft anderen dabei, Nachrichtendienste zu finden, denen ihre Privatsphäre wirklich wichtig ist."
          }
        },
        "el" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Το Session δεν προβάλλει διαφημίσεις, δεν πουλά δεδομένα και απαντά μόνο στους χρήστες του. Η βαθμολογία σας στο {storevariant} βοηθά περισσότερους να ανακαλύψουν επικοινωνία που σέβεται πραγματικά την ιδιωτικότητά τους."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session runs no ads, sells no data, and answers only to its users. Your {storevariant} rating helps more people find messaging that actually respects their privacy."
          }
        },
        "es-419" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session corre sin anuncios, no vende ningún dato, responde solo a sus usuarios. Tu calificación {storevariant} ayuda a que más personas encuentren un servicio de mensajería que realmente respeta su privacidad."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session هیچ آگهی‌ای نمایش نمی‌دهد، هیچ داده‌ای نمی‌فروشد و فقط به کاربرانش پاسخ‌گو است. امتیازدهی شما در {storevariant} به افراد بیشتری به یافتن پیام‌رسانی کمک می‌کند که واقعاً به حریم خصوصی آن‌ها احترام می‌گذارد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session n'affiche aucune publicité, ne vend aucune donnée, et ne répond qu'à ses utilisateurs. Votre avis {storevariant} aide davantage de personnes à trouver une messagerie qui respecte réellement leur confidentialité."
          }
        },
        "my" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session သည် ကြော်ငြာများ မပြသပါ၊ ဒေတာများကို မရောင်းပါ၊ ၎င်း၏ အသုံးပြုသူများကိုသာ တာဝန်ခံပါသည်။ သင်၏ {storevariant} အဆင့်သတ်မှတ်ချက်က ကိုယ်ရေးလုံခြုံမှုကို အမှန်တကယ် လေးစားသော စာပို့ဆက်သွယ်ရေးအက်ပ်ကို လူအများ ရှာဖွေတွေ့ရှိနိုင်ရန် ကူညီပေးပါသည်။"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session не показывает рекламу, не торгует данными и отвечает только перед пользователями. Ваш рейтинг {storevariant} помогает людям обрести мессенджер, который уважает их приватность."
          }
        },
        "zh-CN" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session 不包含广告、不出售数据，并且只对用户负责。您在 {storevariant} 上的评分有助于更多人发现真正尊重隐私的消息应用。"
          }
        }
      }
    },
