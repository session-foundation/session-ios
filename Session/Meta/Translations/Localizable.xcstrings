    "proAccessRestoredDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتشف Session واستعاد الوصول إلى Pro لحسابكم. تمت استعادة حالة Pro الخاصة بكم!"
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session, hesabınız üçün Pro erişimini aşkarladı və geri qaytardı. Pro statusunuz bərpa edildi!"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
