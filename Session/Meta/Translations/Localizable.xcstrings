            "value" : "Opravdu chcete skrýt <b>Poznámku sobě</b> ze svého seznamu konverzací?"
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Er du sikker på, at du vil skjule <b>Egen note</b> fra din samtaleliste?"
