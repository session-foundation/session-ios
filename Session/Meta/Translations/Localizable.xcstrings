    "proAccessRenewPlatformStoreWebsite" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جددوا وصولكم إلى Pro على <b><span>موقع {platform_store}</span></b> باستخدام حساب {platform_account} الذي استخدمتم للتسجيل في Pro."
