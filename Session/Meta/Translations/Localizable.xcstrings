    "permissionsStorageDenied" : {
      "extractionState" : "manual",
      "localizations" : {
        "af" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session benodig foto-biblioteek toegang sodat jy foto's en video's kan stuur, maar dit is permanent geweier. Tik Instellings → Toestemmings, en skakel \"Foto's en video's\" aan."
          }
        },
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Session إذن الوصول إلى مكتبة الصور لإرسال الصور ومقاطع الفيديو، ولكن تم رفضه نهائيًا. يجب النقر على الإعدادات ثم الأذونات، وتفعيل \"الصور ومقاطع الفيديو\"."
          }
        },
        "az" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foto və video göndərə bilməyiniz üçün Session foto kitabxanasına erişməlidir, ancaq bu erişimə birdəfəlik rədd cavabı verilib. Ayarlar → \"İcazələr\"ə toxunun və \"Foto və videolar\"ı işə salın."
          }
        },
        "bal" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session کماٹ پاتبسینہ محفوظ ثبت، چہ جو مکمبے افعیلت بیزی. لہ کہتت کو قٔائیں وضیجت تیبسینہ پایمر دےیے."
          }
        },
        "be" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session патрабуе доступу да бібліятэкі фота для адпраўкі фота і відэа, але доступ быў пастаянна забаронены. Націсніце «Налады» → «Дазволы» і актывуйце «Фота і відэа»."
          }
        },
        "bg" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Session се нуждае от достъп до фото библиотеката, за да може да изпращате снимки и видеа, но достъпът е бил отказан постоянен. Отидете в Настройки → Разрешения и включете \"Снимки и видеа\"."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
